import { Button, ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ReticleMarker } from "components/reticle-marker.slint";
import { CornerBrackets } from "components/corner-brackets.slint";
import { IconButton } from "components/icon-button.slint";

import "../assets/fonts/IBMPlexSans-Medium.ttf";
import "../assets/fonts/IBMPlexSans-SemiBold.ttf";
import "../assets/fonts/IBMPlexSans-Bold.ttf";
import "../assets/fonts/IBMPlexMono-Regular.ttf";
import "../assets/fonts/IBMPlexMono-Medium.ttf";
import "../assets/fonts/IBMPlexMono-SemiBold.ttf";
import "../assets/fonts/IBMPlexMono-Bold.ttf";

export { Theme }

export struct MarkerData {
    id: string,
    ordinal: int,
    x: float,
    y: float,
    comment: string,
}

export struct FindingThumb {
    id: string,
    time-str: string,
    dimensions-str: string,
    is-selected: bool,
    is-active: bool,
    image: image,
}
export component CaptureOverlayWindow inherits Window {
    title: "Snapdown Capture Overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in-out property <image> snapshot-image;
    in-out property <length> mouse-x: 0px;
    in-out property <length> mouse-y: 0px;
    in-out property <bool> is-dragging: false;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;
    in-out property <length> drag-current-x: 0px;
    in-out property <length> drag-current-y: 0px;
    in-out property <bool> has-selection: false;
    in-out property <length> sel-x: 0px;
    in-out property <length> sel-y: 0px;
    in-out property <length> sel-w: 0px;
    in-out property <length> sel-h: 0px;
    in-out property <string> note-text: "";
    in-out property <bool> is-narrating: false;

    callback capture-completed(int, int, int, int, string);
    callback overlay-cancelled();

    Image {
        width: 100%;
        height: 100%;
        source: root.snapshot-image;
    }

    if !has-selection : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.65);
    }
    if has-selection : Rectangle {
        Rectangle { x: 0px; y: 0px; width: 100%; height: sel-y; background: #000000.with-alpha(0.65); }
        Rectangle { x: 0px; y: sel-y + sel-h; width: 100%; height: parent.height - (sel-y + sel-h); background: #000000.with-alpha(0.65); }
        Rectangle { x: 0px; y: sel-y; width: sel-x; height: sel-h; background: #000000.with-alpha(0.65); }
        Rectangle { x: sel-x + sel-w; y: sel-y; width: parent.width - (sel-x + sel-w); height: sel-h; background: #000000.with-alpha(0.65); }
    }
    if has-selection : Rectangle {
        x: sel-x;
        y: sel-y;
        width: sel-w;
        height: sel-h;
        border-color: Theme.border-focus;
        border-width: 2px;
        background: transparent;

        Rectangle {
            y: -24px;
            x: 0px;
            height: 20px;
            width: 90px;
            border-radius: Theme.radius-sharp;
            background: Theme.accent-primary;
            Text {
                text: (sel-w / 1px) + " × " + (sel-h / 1px);
                color: #ffffff;
                font-size: 11px;
                font-weight: 700;
                font-family: "IBM Plex Mono";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if is-narrating : Rectangle {
            y: parent.height + 12px;
            x: (parent.width - self.width) / 2;
            width: 320px;
            height: 110px;
            background: #ffffff;
            border-radius: Theme.radius-sharp;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000.with-alpha(0.4);

            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: "What is wrong here?";
                    font-size: 11px;
                    font-weight: 700;
                    color: #475569;
                    font-family: "IBM Plex Sans";
                }
                note-input := LineEdit {
                    text <=> root.note-text;
                    placeholder-text: "Type finding note...";
                    accepted => {
                        root.capture-completed(
                            sel-x / 1px,
                            sel-y / 1px,
                            sel-w / 1px,
                            sel-h / 1px,
                            root.note-text
                        );
                    }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Enter to save · Esc to cancel";
                        font-size: 10px;
                        color: #94a3b8;
                        font-family: "IBM Plex Sans";
                    }
                    Button {
                        text: "Save Finding";
                        primary: true;
                        clicked => {
                            root.capture-completed(
                                sel-x / 1px,
                                sel-y / 1px,
                                sel-w / 1px,
                                sel-h / 1px,
                                root.note-text
                            );
                        }
                    }
                }
            }
        }
    }

    if !is-narrating : Rectangle {
        Rectangle {
            x: mouse-x - 0.5px;
            y: 0px;
            width: 1px;
            height: 100%;
            background: Theme.accent-primary.with-alpha(0.8);
        }
        Rectangle {
            x: 0px;
            y: mouse-y - 0.5px;
            width: 100%;
            height: 1px;
            background: Theme.accent-primary.with-alpha(0.8);
        }

        Rectangle {
            x: mouse-x + 24px;
            y: mouse-y + 24px;
            width: 96px;
            height: 96px;
            border-radius: 48px;
            border-width: 2.5px;
            border-color: Theme.border-focus;
            background: #000000;
            clip: true;

            Image {
                x: -(mouse-x * 3 - 48px);
                y: -(mouse-y * 3 - 48px);
                width: root.width * 3;
                height: root.height * 3;
                source: root.snapshot-image;
            }

            Rectangle { x: 47px; y: 0px; width: 2px; height: 96px; background: Theme.border-focus; }
            Rectangle { x: 0px; y: 47px; width: 96px; height: 2px; background: Theme.border-focus; }
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;

        pointer-event(event) => {
            root.mouse-x = self.mouse-x;
            root.mouse-y = self.mouse-y;

            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.is-dragging = true;
                root.drag-start-x = self.mouse-x;
                root.drag-start-y = self.mouse-y;
                root.drag-current-x = self.mouse-x;
                root.drag-current-y = self.mouse-y;
                root.has-selection = false;
                root.is-narrating = false;
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.is-dragging = false;
                root.sel-x = min(root.drag-start-x, root.drag-current-x);
                root.sel-y = min(root.drag-start-y, root.drag-current-y);
                root.sel-w = max(abs(root.drag-current-x - root.drag-start-x), 16px);
                root.sel-h = max(abs(root.drag-current-y - root.drag-start-y), 16px);
                root.has-selection = true;
                root.is-narrating = true;
            }
            if (event.kind == PointerEventKind.cancel) {
                root.overlay-cancelled();
            }
        }

        moved => {
            if (root.is-dragging) {
                root.drag-current-x = self.mouse-x;
                root.drag-current-y = self.mouse-y;
                root.sel-x = min(root.drag-start-x, root.drag-current-x);
                root.sel-y = min(root.drag-start-y, root.drag-current-y);
                root.sel-w = max(abs(root.drag-current-x - root.drag-start-x), 4px);
                root.sel-h = max(abs(root.drag-current-y - root.drag-start-y), 4px);
                root.has-selection = true;
            }
        }
    }
}
export component AppWindow inherits Window {
    title: "Snapdown";
    icon: @image-url("../assets/app-icon.ico");
    no-frame: true;
    min-width: 1024px;
    min-height: 720px;
    preferred-width: 1366px;
    preferred-height: 860px;
    background: Theme.bg-app;
    default-font-family: "IBM Plex Sans";

    in-out property <bool> is-dark-theme <=> Theme.is-dark;

    out property <color> bg-app: Theme.bg-app;
    out property <color> bg-card: Theme.bg-card;
    out property <color> bg-subtle: Theme.bg-subtle;
    out property <color> bg-hover: Theme.bg-hover;
    out property <color> border-subtle: Theme.border-subtle;
    out property <color> border-strong: Theme.border-strong;
    out property <color> text-primary: Theme.text-primary;
    out property <color> text-secondary: Theme.text-secondary;
    out property <color> text-muted: Theme.text-muted;
    out property <color> text-dim: Theme.text-dim;

    in-out property <string> current-filename: "capture_20260826_041750.png";
    in-out property <int> active-tool-index: 0;
    in-out property <int> active-tab-index: 0;
    in-out property <string> observation-summary: "test\n1. Marker 1\n2. Marker 2";
    in-out property <int> selected-finding-count: 0;
    in-out property <string> resolution-text: "1020 × 885  px";
    in-out property <string> size-text: "119.5  KB";
    in-out property <image> active-image;
    in-out property <[MarkerData]> markers: [
        { id: "m1", ordinal: 1, x: 0.28, y: 0.31, comment: "Marker 1" },
        { id: "m2", ordinal: 2, x: 0.36, y: 0.49, comment: "Marker 2" },
    ];
    in-out property <[FindingThumb]> filmstrip-items: [];

    callback finding-selected(string);
    callback library-clicked();
    callback capture-clicked();
    callback open-file-clicked();
    callback paste-clicked();
    callback assemble-bundle-clicked();
    callback copy-image-clicked();
    callback share-bundle-clicked();
    callback marker-placed(float, float);
    callback delete-marker-clicked(string);
    callback drag-window-requested();
    callback theme-toggle-clicked();
    callback bundles-drawer-clicked();
    callback settings-clicked();
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg-app;
        border-width: 1px;
        border-color: root.border-strong;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            titlebar := Rectangle {
                height: 32px;
                background: root.bg-app;

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: root.border-subtle;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.drag-window-requested();
                        }
                    }
                    double-clicked => {
                        root.maximize-clicked();
                    }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: 0px;
                    height: parent.height;
                    text: root.current-filename;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.text-muted;
                    font-family: "IBM Plex Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    padding-left: 0px;
                    padding-right: 0px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        Rectangle {
                            width: 32px;
                            height: 32px;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                image-fit: contain;
                                source: @image-url("../assets/app-icon.ico");
                            }
                        }

                        Text {
                            text: "Snapdown";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.text-secondary;
                            vertical-alignment: center;
                            font-family: "IBM Plex Sans";
                        }
                    }

                    HorizontalLayout {
                        spacing: 0px;
                        alignment: end;

                        Rectangle {
                            width: 32px; height: 32px;
                            background: theme-touch.has-hover ? root.bg-hover : transparent;

                            Image {
                                width: 15px; height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                                source: root.is-dark-theme ? @image-url("../assets/icons/sun.svg") : @image-url("../assets/icons/moon.svg");
                            }

                            theme-touch := TouchArea {
                                clicked => {
                                    root.is-dark-theme = !root.is-dark-theme;
                                    root.theme-toggle-clicked();
                                }
                            }
                        }

                        Rectangle {
                            width: 32px; height: 32px;
                            background: settings-touch.has-hover ? root.bg-hover : transparent;

                            Image {
                                width: 15px; height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                                source: @image-url("../assets/icons/settings.svg");
                            }

                            settings-touch := TouchArea { clicked => { root.settings-clicked(); } }
                        }

                        Rectangle { width: 1px; height: 16px; background: root.border-strong; y: 8px; }

                        Rectangle {
                            width: 46px; height: 32px; background: min-touch.has-hover ? root.bg-hover : transparent;

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 1px;
                                background: root.text-secondary;
                            }
                            min-touch := TouchArea { clicked => { root.minimize-clicked(); } }
                        }

                        Rectangle {
                            width: 46px; height: 32px; background: max-touch.has-hover ? root.bg-hover : transparent;

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                border-width: 1px;
                                border-color: root.text-secondary;
                                background: transparent;
                            }
                            max-touch := TouchArea { clicked => { root.maximize-clicked(); } }
                        }

                        Rectangle {
                            width: 46px; height: 32px; background: close-touch.has-hover ? #e81123 : transparent;

                            Path {
                                width: 10px;
                                height: 10px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                stroke-width: 1.2px;
                                stroke: close-touch.has-hover ? #ffffff : root.text-secondary;
                                MoveTo { x: 0; y: 0; }
                                LineTo { x: 10; y: 10; }
                                MoveTo { x: 10; y: 0; }
                                LineTo { x: 0; y: 10; }
                            }
                            close-touch := TouchArea { clicked => { root.close-clicked(); } }
                        }
                    }
                }
            }
            // TOOLBAR & RIBBON ACTION STRIP
            Rectangle {
                height: 52px;
                background: root.bg-app;

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: root.border-subtle;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 8px;
                    alignment: space-between;

                    // Group 1 (Left): Library / History & Input Actions
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;

                        IconButton {
                            width: 52px;
                            height: 44px;
                            icon: @image-url("../assets/icons/library.svg");
                            text: "Library";
                            clicked => { root.library-clicked(); }
                        }

                        Rectangle { width: 1px; height: 24px; background: root.border-strong; y: 10px; }

                        IconButton {
                            width: 54px;
                            height: 44px;
                            icon: @image-url("../assets/icons/camera.svg");
                            text: "Capture";
                            custom-text-color: #e11d48;
                            clicked => { root.capture-clicked(); }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: @image-url("../assets/icons/folder.svg");
                            text: "Open";
                            clicked => { root.open-file-clicked(); }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: @image-url("../assets/icons/clipboard.svg");
                            text: "Paste";
                            clicked => { root.paste-clicked(); }
                        }
                    }

                    // Group 2 (Center): Snug Annotation Palette Strip
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 0 ? @image-url("../assets/icons/marker-active.svg") : @image-url("../assets/icons/marker-inactive.svg");
                            text: "Marker";
                            active: root.active-tool-index == 0;
                            ordinal-hint: "1";
                            clicked => { root.active-tool-index = 0; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 1 ? @image-url("../assets/icons/square-active.svg") : @image-url("../assets/icons/square.svg");
                            text: "Shape";
                            active: root.active-tool-index == 1;
                            ordinal-hint: "2";
                            clicked => { root.active-tool-index = 1; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 2 ? @image-url("../assets/icons/message-square-active.svg") : @image-url("../assets/icons/message-square.svg");
                            text: "Callout";
                            active: root.active-tool-index == 2;
                            ordinal-hint: "3";
                            clicked => { root.active-tool-index = 2; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 3 ? @image-url("../assets/icons/blur-active.svg") : @image-url("../assets/icons/blur.svg");
                            text: "Blur";
                            active: root.active-tool-index == 3;
                            ordinal-hint: "4";
                            clicked => { root.active-tool-index = 3; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 4 ? @image-url("../assets/icons/arrow-up-right-active.svg") : @image-url("../assets/icons/arrow-up-right.svg");
                            text: "Arrow";
                            active: root.active-tool-index == 4;
                            ordinal-hint: "5";
                            clicked => { root.active-tool-index = 4; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 5 ? @image-url("../assets/icons/type-active.svg") : @image-url("../assets/icons/type.svg");
                            text: "Text";
                            active: root.active-tool-index == 5;
                            ordinal-hint: "6";
                            clicked => { root.active-tool-index = 5; }
                        }

                        Rectangle { width: 1px; height: 24px; background: Theme.border-strong; y: 10px; }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 6 ? @image-url("../assets/icons/crop-active.svg") : @image-url("../assets/icons/crop.svg");
                            text: "Crop";
                            active: root.active-tool-index == 6;
                            clicked => { root.active-tool-index = 6; }
                        }

                        Rectangle { width: 1px; height: 24px; background: Theme.border-strong; y: 10px; }

                        IconButton {
                            width: 40px;
                            height: 44px;
                            icon: @image-url("../assets/icons/undo.svg");
                            text: "Undo";
                        }
                        IconButton {
                            width: 40px;
                            height: 44px;
                            icon: @image-url("../assets/icons/redo.svg");
                            text: "Redo";
                        }
                    }

                    // Group 3 (Right): Assemble & Sharing Action Buttons
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        Rectangle {
                            width: 68px;
                            height: 44px;
                            border-radius: Theme.radius-sharp;
                            background: assem-touch.pressed ? Theme.accent-pressed : (assem-touch.has-hover ? Theme.accent-hover : Theme.accent-primary);
                            drop-shadow-blur: assem-touch.has-hover ? 6px : 2px;
                            drop-shadow-color: Theme.accent-primary.with-alpha(0.35);

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Image {
                                    width: 16px; height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    image-fit: contain;
                                    source: @image-url("../assets/icons/package.svg");
                                }
                                Text { text: "Assemble"; font-size: 10px; font-weight: 700; color: Theme.text-on-accent; horizontal-alignment: center; font-family: "IBM Plex Sans"; }
                            }
                            assem-touch := TouchArea { clicked => { root.assemble-bundle-clicked(); } }
                        }

                        Rectangle {
                            width: 52px;
                            height: 44px;
                            border-radius: Theme.radius-sharp;
                            background: cp-touch.pressed ? Theme.accent-pressed : (cp-touch.has-hover ? Theme.accent-hover : Theme.accent-primary);
                            drop-shadow-blur: cp-touch.has-hover ? 6px : 2px;
                            drop-shadow-color: Theme.accent-primary.with-alpha(0.35);

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Image {
                                    width: 15px; height: 15px;
                                    x: (parent.width - self.width) / 2;
                                    image-fit: contain;
                                    source: @image-url("../assets/icons/copy-white.svg");
                                }
                                Text { text: "Copy"; font-size: 10px; font-weight: 700; color: Theme.text-on-accent; horizontal-alignment: center; font-family: "IBM Plex Sans"; }
                            }
                            cp-touch := TouchArea { clicked => { root.copy-image-clicked(); } }
                        }

                        Rectangle {
                            width: 52px;
                            height: 44px;
                            border-radius: Theme.radius-sharp;
                            background: sh-touch.pressed ? Theme.accent-pressed : (sh-touch.has-hover ? Theme.accent-hover : Theme.accent-primary);
                            drop-shadow-blur: sh-touch.has-hover ? 6px : 2px;
                            drop-shadow-color: Theme.accent-primary.with-alpha(0.35);

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Image {
                                    width: 15px; height: 15px;
                                    x: (parent.width - self.width) / 2;
                                    image-fit: contain;
                                    source: @image-url("../assets/icons/share-white.svg");
                                }
                                Text { text: "Share"; font-size: 10px; font-weight: 700; color: Theme.text-on-accent; horizontal-alignment: center; font-family: "IBM Plex Sans"; }
                            }
                            sh-touch := TouchArea { clicked => { root.share-bundle-clicked(); } }
                        }
                    }
                }
            }
            // MAIN WORKSPACE
            HorizontalLayout {
                spacing: 0px;

                VerticalLayout {
                    horizontal-stretch: 1;

                    // Central Image Viewport Canvas
                    Rectangle {
                        vertical-stretch: 1;
                        background: root.bg-card;

                        canvas-viewport := Rectangle {
                            width: 90%;
                            height: 90%;
                            background: #0f172a;
                            border-radius: Theme.radius-sharp;
                            drop-shadow-blur: 20px;
                            drop-shadow-color: #000000.with-alpha(0.18);

                            main-img := Image {
                                width: 100%;
                                height: 100%;
                                source: root.active-image;
                            }

                            // Corner Brackets Viewfinder Overlay
                            CornerBrackets {
                                size: 16px;
                                stroke: 1.5px;
                                color: Theme.border-strong;
                                inset: 4px;
                            }

                            // Numbered Reticle Marker Overlay
                            for m in root.markers : ReticleMarker {
                                x: m.x * parent.width - 15px;
                                y: m.y * parent.height - 15px;
                                ordinal: m.ordinal;
                            }

                            TouchArea {
                                clicked => {
                                    root.marker-placed(self.mouse-x / parent.width, self.mouse-y / parent.height);
                                }
                            }
                        }
                    }

                    // Readout Status Strip
                    Rectangle {
                        height: 28px;
                        background: root.bg-subtle;

                        Rectangle { y: 0px; width: 100%; height: 1px; background: root.border-subtle; }
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: root.border-subtle; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                Image {
                                    width: 12px; height: 12px;
                                    image-fit: contain;
                                    source: @image-url("../assets/icons/ruler.svg");
                                }
                                Text { text: root.resolution-text; font-size: 11px; font-family: "IBM Plex Mono"; color: root.text-muted; vertical-alignment: center; }
                            }
                            Text { text: "·"; font-size: 11px; color: root.border-strong; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                Image {
                                    width: 12px; height: 12px;
                                    image-fit: contain;
                                    source: @image-url("../assets/icons/hard-drive.svg");
                                }
                                Text { text: root.size-text; font-size: 11px; font-family: "IBM Plex Mono"; color: root.text-muted; vertical-alignment: center; }
                            }
                        }
                    }

                    // BOTTOM FILMSTRIP TRAY
                    Rectangle {
                        height: 110px;
                        background: root.bg-app;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            alignment: start;

                            Rectangle {
                                width: 110px;
                                height: 86px;
                                background: root.bg-card;
                                border-radius: Theme.radius-sharp;
                                border-width: 1px;
                                border-color: root.border-strong;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: root.selected-finding-count + " selected";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.text-primary;
                                        horizontal-alignment: center;
                                        font-family: "IBM Plex Sans";
                                    }
                                    Rectangle {
                                        height: 26px;
                                        width: 86px;
                                        border-radius: Theme.radius-sharp;
                                        background: Theme.accent-primary;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;
                                            Image {
                                                width: 12px; height: 12px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/package.svg");
                                            }
                                            Text {
                                                text: "Assemble";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                font-family: "IBM Plex Sans";
                                            }
                                        }
                                    }
                                }
                            }

                            for thumb in root.filmstrip-items : Rectangle {
                                width: 120px;
                                height: 86px;
                                background: #0f172a;
                                border-radius: Theme.radius-sharp;
                                border-width: thumb.is-active ? 2px : 1px;
                                border-color: thumb.is-active ? Theme.accent-primary : root.border-strong;
                                clip: true;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                    source: thumb.image;
                                }

                                if thumb.is-active : Rectangle {
                                    y: 36px;
                                    x: (parent.width - self.width) / 2;
                                    width: 70px;
                                    height: 20px;
                                    border-radius: Theme.radius-pill;
                                    background: Theme.semantic-success-bg;
                                    Text {
                                        text: "● Editing";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: Theme.semantic-success;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-family: "IBM Plex Sans";
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 18px;
                                    width: 100%;
                                    height: 18px;
                                    background: root.bg-card;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: space-between;
                                        Text { text: thumb.time-str; font-size: 9px; font-family: "IBM Plex Mono"; color: root.text-secondary; vertical-alignment: center; }
                                        Text { text: thumb.dimensions-str; font-size: 9px; font-family: "IBM Plex Mono"; color: root.text-muted; vertical-alignment: center; }
                                    }
                                }

                                TouchArea {
                                    clicked => {
                                        root.finding-selected(thumb.id);
                                    }
                                }
                            }
                        }
                    }
                }
                // RIGHT PANEL: 440px INSPECTOR
                Rectangle {
                    width: 440px;
                    background: root.bg-app;

                    Rectangle { x: 0px; width: 1px; height: 100%; background: root.border-subtle; }

                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        // TAB HEADERS ([Notes] & [Properties])
                        Rectangle {
                            height: 46px;
                            background: root.bg-app;

                            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: root.border-subtle; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;

                                // Tab 0: Notes
                                Rectangle {
                                    width: 100px;
                                    Rectangle {
                                        y: parent.height - 2.5px;
                                        width: 100%;
                                        height: root.active-tab-index == 0 ? 2.5px : 0px;
                                        background: Theme.accent-primary;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Rectangle {
                                            width: 14px;
                                            height: parent.height;
                                            Image {
                                                y: (parent.height - self.height) / 2 + 1px;
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/file-text.svg");
                                            }
                                        }
                                        Text {
                                            text: "Notes";
                                            font-size: 13px;
                                            font-weight: root.active-tab-index == 0 ? 700 : 500;
                                            color: root.active-tab-index == 0 ? Theme.accent-primary : root.text-muted;
                                            vertical-alignment: center;
                                            font-family: "IBM Plex Sans";
                                        }
                                    }
                                    TouchArea { clicked => { root.active-tab-index = 0; } }
                                }

                                // Tab 1: Properties
                                Rectangle {
                                    width: 120px;
                                    Rectangle {
                                        y: parent.height - 2.5px;
                                        width: 100%;
                                        height: root.active-tab-index == 1 ? 2.5px : 0px;
                                        background: Theme.accent-primary;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Rectangle {
                                            width: 14px;
                                            height: parent.height;
                                            Image {
                                                y: (parent.height - self.height) / 2 + 1px;
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/palette.svg");
                                            }
                                        }
                                        Text {
                                            text: "Properties";
                                            font-size: 13px;
                                            font-weight: root.active-tab-index == 1 ? 700 : 500;
                                            color: root.active-tab-index == 1 ? Theme.accent-primary : root.text-muted;
                                            vertical-alignment: center;
                                            font-family: "IBM Plex Sans";
                                        }
                                    }
                                    TouchArea { clicked => { root.active-tab-index = 1; } }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;

                            if root.active-tab-index == 0 : VerticalLayout {
                                padding: 16px;
                                spacing: 16px;

                                // Section 1: Observation Summary
                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "OBSERVATION SUMMARY";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: root.text-secondary;
                                        letter-spacing: 0.5px;
                                        font-family: "IBM Plex Sans";
                                    }
                                    Rectangle {
                                        height: 120px;
                                        border-radius: Theme.radius-sharp;
                                        border-width: 1px;
                                        border-color: root.border-strong;
                                        background: root.bg-card;
                                        TextEdit {
                                            text <=> root.observation-summary;
                                            font-size: 13px;
                                        }
                                    }
                                }

                                // Section 2: Step Marker Notes
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "STEP MARKER NOTES (" + root.markers.length + ")";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: root.text-secondary;
                                        letter-spacing: 0.5px;
                                        font-family: "IBM Plex Sans";
                                    }

                                    for marker in root.markers : Rectangle {
                                        border-radius: Theme.radius-sharp;
                                        background: root.bg-card;
                                        border-width: 1px;
                                        border-color: root.border-strong;

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    ReticleMarker {
                                                        ordinal: marker.ordinal;
                                                    }
                                                    Text { text: "Marker #" + marker.ordinal; font-size: 12px; font-weight: 700; color: root.text-primary; vertical-alignment: center; font-family: "IBM Plex Sans"; }
                                                    Text { text: "(" + round(marker.x * 100) + "%, " + round(marker.y * 100) + "%)"; font-size: 10px; color: root.text-muted; vertical-alignment: center; font-family: "IBM Plex Mono"; }
                                                }
                                                Text {
                                                    text: "✕";
                                                    font-size: 12px;
                                                    color: root.text-muted;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Rectangle {
                                                height: 32px;
                                                background: root.bg-subtle;
                                                border-radius: Theme.radius-sharp;
                                                border-width: 1px;
                                                border-color: root.border-subtle;
                                                LineEdit {
                                                    text: marker.comment;
                                                    font-size: 12px;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Section 3: Estimated LLM Cost Card
                                Rectangle {
                                    height: 84px;
                                    border-radius: Theme.radius-sharp;
                                    background: root.bg-card;
                                    border-width: 1px;
                                    border-color: root.border-strong;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 13px; height: 13px;
                                                    image-fit: contain;
                                                    source: @image-url("../assets/icons/coins.svg");
                                                }
                                                Text { text: "ESTIMATED LLM COST"; font-size: 10px; font-weight: 800; color: root.text-secondary; font-family: "IBM Plex Sans"; }
                                            }
                                            Text { text: "~1.217 TK"; font-size: 12px; font-weight: 800; color: Theme.accent-primary; font-family: "IBM Plex Mono"; }
                                        }
                                        HorizontalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 12px; height: 12px;
                                                    image-fit: contain;
                                                    source: @image-url("../assets/icons/image.svg");
                                                }
                                                Text { text: "Image (1020×885)"; font-size: 11px; color: root.text-muted; font-family: "IBM Plex Sans"; }
                                            }
                                            Text { text: "~1204 tk"; font-size: 11px; color: root.text-muted; font-family: "IBM Plex Mono"; }
                                        }
                                        HorizontalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 12px; height: 12px;
                                                    image-fit: contain;
                                                    source: @image-url("../assets/icons/file-lines.svg");
                                                }
                                                Text { text: "Notes (46 chars)"; font-size: 11px; color: root.text-muted; font-family: "IBM Plex Sans"; }
                                            }
                                            Text { text: "~13 tk"; font-size: 11px; color: root.text-muted; font-family: "IBM Plex Mono"; }
                                        }
                                    }
                                }
                            }

                            if root.active-tab-index == 1 : VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "ELEMENT PROPERTIES";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: root.text-secondary;
                                    font-family: "IBM Plex Sans";
                                }

                                Rectangle {
                                    height: 120px;
                                    background: root.bg-card;
                                    border-radius: Theme.radius-sharp;
                                    border-width: 1px;
                                    border-color: root.border-strong;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "Font Family"; font-size: 11px; font-weight: 700; color: root.text-muted; font-family: "IBM Plex Sans"; }
                                        LineEdit { text: "IBM Plex Sans, sans-serif"; }
                                        Text { text: "Font Size: 14px"; font-size: 11px; font-weight: 700; color: root.text-muted; font-family: "IBM Plex Sans"; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
