// Copyright © Wira Digital Indonesia
//
// ONE action button for the whole product, taken from the Editor's own.
//
// This exists for the same reason `SdTextField` does: `std-widgets`' `Button` paints itself from
// Slint's style palette rather than from `theme.slint`, so the capture panel's Save action was a
// different size, a different colour and a different type scale from every button in the Editor -
// while the Editor's own actions (Share, Copy, Assemble) were all hand-built from the tokens and
// agreed with each other.
//
// The values here are not new. They are the Editor's: `radius-sharp`, the
// accent-primary/hover/pressed triple, `text-on-accent`, 10-11px at weight 700, and an accent-tinted
// shadow that lifts on hover. Changing one of them changes every action in the product, which is the
// point.
//
// A styled `Button` MUST NOT be reintroduced anywhere in this product.

import { Theme } from "../theme.slint";

export component SdActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: true;
    // `BUG-103`: a genuinely irreversible action (Delete, Discard originals, Delete both) read
    // identically to Disassemble - the one confirm verb among the four that is NOT final, since it
    // gives the Findings back. `danger` swaps the primary background/glow for `semantic-error`
    // instead of the accent colour, so the one button in a dialog that cannot be undone reads that
    // way at a glance. Only meaningful when `primary` is also true - a non-primary danger button
    // would be a contradiction (an outlined button already reads as the SAFER of two choices).
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> label-size: 11px;

    callback clicked();

    height: 32px;
    // Sized from its contents, with the Editor's own horizontal breathing room, so a longer label
    // does not get clipped and a short one does not float in a wide slab.
    min-width: body.min-width + 24px;
    border-radius: Theme.radius-sharp;
    background: !root.enabled
        ? Theme.bg-hover
        : (root.primary
            ? (root.danger
                ? (touch.pressed ? Theme.semantic-error.darker(20%) : (touch.has-hover ? Theme.semantic-error.brighter(10%) : Theme.semantic-error))
                : (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent-primary)))
            : (touch.has-hover ? Theme.bg-hover : Theme.bg-card));
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: (root.primary && root.enabled) ? (touch.has-hover ? 6px : 2px) : 0px;
    drop-shadow-color: root.danger ? Theme.semantic-error.with-alpha(0.35) : Theme.accent-primary.with-alpha(0.35);

    body := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0 : Image {
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            source: root.icon;
            colorize: !root.enabled ? Theme.text-dim : (root.primary ? Theme.text-on-accent : Theme.text-secondary);
        }
        Text {
            text: root.label;
            font-size: root.label-size;
            font-weight: 700;
            font-family: "IBM Plex Sans";
            color: !root.enabled ? Theme.text-dim : (root.primary ? Theme.text-on-accent : Theme.text-secondary);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => {
            // A disabled action does not fire. Reporting "nothing to do" after taking the click is
            // the shape BUG-57 is about.
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

/// A section heading, the way the Editor's inspector writes one.
///
/// The capture panel said "What is wrong here?" at 11px/700 in sentence case while the panel it is
/// supposed to match says "OBSERVATION SUMMARY" at 11px/800 with 0.5px of letter-spacing. Two
/// dialects for one idea, and the sort of drift that is invisible until the two are seen together.
export component SdSectionLabel inherits Text {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: Theme.text-secondary;
    font-family: "IBM Plex Sans";
}

/// A caption: a hint, a timestamp, a dimension readout.
export component SdCaption inherits Text {
    font-size: 10px;
    color: Theme.text-dim;
    font-family: "IBM Plex Sans";
    vertical-alignment: center;
}

/// A heading inside a RENDERED document, at a Markdown level.
///
/// The Assemble preview used `SdSectionLabel` for its sections - 11px, upper case, letter-spaced -
/// which is the inspector's vocabulary for a panel heading and says nothing about depth. In a
/// document, `## Bundle Notes` and `## Finding 1` are the same level and have to look it. The
/// owner's words: "maunya mencerminkan markdown preview sebenarnya".
export component SdDocHeading inherits Text {
    in property <int> level: 2;

    font-size: root.level == 1 ? 19px : (root.level == 2 ? 15px : 13px);
    font-weight: 800;
    color: Theme.text-primary;
    font-family: "IBM Plex Sans";
    wrap: word-wrap;
}
