import { Theme } from "../theme.slint";

// A numbered Marker on the canvas.
//
// It used to carry four crosshair ticks and a 2px `bg-hover` contrast ring around the dot. Both are
// gone at the owner's direction: over a real screenshot the ring read as a white halo and the ticks
// as damage to the image underneath. What identifies a Marker is the numeral, and the shadow is what
// keeps it legible over a light capture - a ring is a second answer to a question the shadow already
// answers.
//
// The 30px box stays, because the canvas positions a Marker by `m.x * width - 15px`. The dot grew
// from 16px to 20px to fill the space the ring left.
export component ReticleMarker {
    in-out property <int> ordinal: 1;
    in-out property <bool> active: false;

    width: 30px;
    height: 30px;

    Rectangle {
        x: 5px;
        y: 5px;
        width: 20px;
        height: 20px;
        border-radius: Theme.radius-pill;
        // The red the burn uses. This was `semantic-error` #ef4444 while `burner.rs` fills the
        // badge in `COLOR_MARKER_FILL` #dc2626 - so the canvas previewed one red and the PNG held
        // another. `annotation-stroke` is bound to `COLOR_MARKER_FILL` by its own comment, which
        // makes it the one token that cannot drift from the saved image.
        background: Theme.annotation-stroke;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.marker-shadow;

        Text {
            text: root.ordinal;
            color: Theme.text-on-plate;
            font-size: 11px;
            font-weight: 700;
            font-family: "IBM Plex Mono";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
