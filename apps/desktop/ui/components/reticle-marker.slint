import { Theme } from "../theme.slint";

export component ReticleMarker {
    in-out property <int> ordinal: 1;
    in-out property <bool> active: false;

    width: 30px;
    height: 30px;

    // Crosshair ticks: N, S, E, W (1.5px thick, 6px length, 60% opacity)
    // North tick
    Rectangle {
        x: (parent.width - 1.5px) / 2;
        y: 0px;
        width: 1.5px;
        height: 6px;
        background: Theme.semantic-error.with-alpha(0.60);
    }
    // South tick
    Rectangle {
        x: (parent.width - 1.5px) / 2;
        y: parent.height - 6px;
        width: 1.5px;
        height: 6px;
        background: Theme.semantic-error.with-alpha(0.60);
    }
    // West tick
    Rectangle {
        x: 0px;
        y: (parent.height - 1.5px) / 2;
        width: 6px;
        height: 1.5px;
        background: Theme.semantic-error.with-alpha(0.60);
    }
    // East tick
    Rectangle {
        x: parent.width - 6px;
        y: (parent.height - 1.5px) / 2;
        width: 6px;
        height: 1.5px;
        background: Theme.semantic-error.with-alpha(0.60);
    }

    // Outer 2px contrast ring around the dot
    Rectangle {
        x: 5px;
        y: 5px;
        width: 20px;
        height: 20px;
        border-radius: Theme.radius-pill;
        border-width: 2px;
        border-color: Theme.bg-hover;
        background: transparent;
    }

    // Center dot (16px diameter, inset 7px from 30px box)
    Rectangle {
        x: 7px;
        y: 7px;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius-pill;
        background: Theme.semantic-error;
        drop-shadow-blur: 4px;
        drop-shadow-color: #000000.with-alpha(0.35);

        Text {
            text: root.ordinal;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            font-family: "IBM Plex Mono";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

