import { Theme } from "../theme.slint";

// THE HEADER EVERY MODAL IN THIS PRODUCT WEARS.
//
// The owner reported it as *"window title bar dari assemble and review dengan setting itu berbeda"*,
// and that is exactly what `design-system-guide.md` warns about: *"Two places showing the same kind
// of thing MUST reference the same component, not the same numbers. Matching numbers drift the first
// time one is touched."* The Assemble & Review header was 52px with a 15px accent icon, a 13px/800
// title and a drawn ✕; the Settings header was 52px with a 15px/700 title and a "Done" BUTTON in the
// corner. Two headers, two answers.
//
// The G3 design settles which one is right: `06a-settings-general.html` has icon + title on the left
// and a ✕ on the right, with the primary action in a FOOTER. Assemble & Review already did that.
//
// Anything passed as a child lands to the left of the ✕ - a readout, a segmented control - so the
// slot is where two modals legitimately differ.
export component SdModalHeader inherits Rectangle {
    in property <image> icon;
    in property <string> title;

    callback closed();

    height: 52px;
    background: Theme.bg-card;

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 15px;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 15px;
                    height: 15px;
                    image-fit: contain;
                    source: root.icon;
                    colorize: Theme.accent-primary;
                }
            }
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 800;
                color: Theme.text-primary;
                vertical-alignment: center;
                font-family: "IBM Plex Sans";
            }
        }

        // Whatever the caller puts here, right-aligned beside the close.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            alignment: end;
            @children
        }

        Rectangle {
            width: 26px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: Theme.radius-sharp;
                    background: close-touch.has-hover ? Theme.bg-hover : transparent;
                    close-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.closed(); }
                    }
                    // A drawn icon. The bare `✕` glyph fell back to whatever the font had and
                    // rendered wrong - the same fault as the Marker delete affordance, in the same
                    // session.
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 13px;
                        height: 13px;
                        image-fit: contain;
                        source: @image-url("../../assets/icons/x.svg");
                        colorize: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                    }
                }
            }
        }
    }
}

// THE TOAST EVERY MODAL WEARS - and the Editor itself, when nothing is open over it.
//
// `BUG-100`: this used to be ONE copy, positioned relative to the whole window - fine while nothing
// covered the Editor, wrong the moment a modal did, since a toast fired by an action INSIDE that
// modal (Copy Markdown, Save, Discard originals) rendered behind the modal's own opaque panel and
// scrim, invisible to the Reviewer who just triggered it. `design-system-guide.md`'s own rule
// applies here exactly as it does to `SdModalHeader` above: "Two places showing the same kind of
// thing MUST reference the same component, not the same numbers" - so this is ONE component,
// positioned by each caller relative to whatever `parent` actually is (the window root when nothing
// is open over it; one modal's own `panel` when something is), rather than four copies of the same
// Rectangle drifting apart the first time one of them is touched.
//
// `visible`, not `if`, matching the ratchet this codebase already carries (`appwindow.slint`'s own
// loupe/crosshair comment): an `if` tears the whole subtree down and rebuilds it on every text
// change, which risked the same one-frame blank-paint the loupe was fixed for once already.
//
// `x`/`y`/`width` are each CALLER's own job, not this component's: Slint rejects a reusable
// `export component`'s own root reading `parent` ("Cannot access id 'parent'") - `parent` only
// resolves at a literal use site, which differs per caller anyway (the window root here, one
// modal's own `panel` there). Every call site follows the same formula
// (`x: (parent.width - self.width) / 2; width: min(560px, parent.width - 64px); y: parent.height -
// self.height - <clearance>;`) with only the clearance differing, which is the one thing that
// genuinely cannot be shared: it depends on whether - and how tall - the caller's own footer is.
export component SdToast inherits Rectangle {
    in property <string> text;
    in property <bool> is-error;

    visible: root.text != "";
    height: 42px;
    border-radius: Theme.radius-sharp;
    background: Theme.bg-card;
    border-width: 1px;
    border-color: root.is-error ? Theme.semantic-error : Theme.semantic-success;
    drop-shadow-blur: 18px;
    drop-shadow-color: Theme.overlay-shadow;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-pill;
            background: root.is-error ? Theme.semantic-error : Theme.semantic-success;
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            wrap: word-wrap;
            font-family: "IBM Plex Sans";
        }
    }
}

// A SUNKEN CARD around one group of settings.
//
// The G3 design puts every settings group in one of these - sunken surface, 1px border, 14px padding,
// 8px gap - and the first build of the Settings screen used bare dividers instead. With four groups
// on one scrolling column and nothing enclosing them, the owner's reading was that the placement
// looked untidy, which it was: a divider says "these are different" and a card says "this is one
// thing".
export component SdCard inherits Rectangle {
    background: Theme.bg-subtle;
    border-width: 1px;
    border-color: Theme.border-subtle;
    border-radius: Theme.radius-sharp;
    height: body.preferred-height;

    body := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        @children
    }
}
