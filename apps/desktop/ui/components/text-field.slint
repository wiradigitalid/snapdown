// Copyright © Wira Digital Indonesia
//
// ONE text field for the whole product.
//
// This exists because `std-widgets`' `LineEdit` and `TextEdit` do not use this product's palette at
// all: they paint themselves from Slint's own style palette, which is why the Observation Summary
// rendered white-on-white on a white panel and only became legible once focused - and why it turned
// grey while being edited. Two different text-entry behaviours in one product, neither of them ours.
//
// The capture overlay's note field was already drawn by hand from `Theme`, for the same reason and
// after the same discovery. This is that field, extracted, so the capture note and the Editor's
// summary are literally the same component rather than two implementations that agree by luck.
//
// A styled `LineEdit`/`TextEdit` MUST NOT be reintroduced anywhere in this product.

import { Theme } from "../theme.slint";

export component SdTextField inherits Rectangle {
    in property <string> placeholder;
    in property <length> text-size: 13px;
    // Single-line SEMANTICS - `accepted` fires, so Enter can commit - with wrapping DISPLAY, because
    // a note that scrolls off to the right hides what has just been typed. Those two are compatible:
    // `TextInput::layout_info` in i-slint-core consults `wrap()` without regard for `single_line()`.
    in property <bool> commit-on-enter: false;
    // Fires `accepted` when the field loses focus, not only on Enter. Off by default so a note or
    // title field is not committed just because the Reviewer clicked somewhere else mid-thought;
    // a numeric field paired with a slider wants both, since clicking the slider itself is a
    // perfectly normal way to leave the field without ever pressing Enter - and the field is left
    // showing what was typed, uncommitted, until it does.
    in property <bool> commit-on-blur: false;
    in property <length> pad: 10px;
    // FLAT: no fill, and no border until it is hovered or focused.
    //
    // For a field that lives inside a rendered document rather than on a form. The Assemble preview
    // shows the handoff as the agent will read it, and a boxed input in the middle of that reads as
    // a form control in a document - the owner's words were "kenapa harus dikotakin". It is still
    // the same component, so the type scale, the caret colour and the placeholder behaviour cannot
    // drift from the boxed one.
    in property <bool> flat: false;
    // Shown, not editable. Used while the document has been hand-edited in the Code view, where
    // rewriting a note would silently discard what the Reviewer typed.
    in property <bool> read-only: false;
    // Monospace, for text whose alignment carries meaning - the Assemble preview's Code view is
    // CommonMark, and a proportional font makes its structure unreadable.
    in property <bool> mono: false;
    // Opt-in: hand Ctrl+C and Ctrl+Enter to the caller BEFORE `TextInput` consumes them.
    //
    // Default OFF, and that default is the point. This is the product's ONE text field, and the
    // Editor's Observation Summary is the same component: a field that quietly stopped copying its
    // own text would be a regression in a screen that never asked for any of this.
    //
    // Needed because the capture overlay's note field takes focus the moment the note panel appears,
    // so by the time the Reviewer reaches for a chord this field owns the keyboard. Handling those
    // chords in the overlay's own `FocusScope` cannot work - a focused `TextInput` gets the key
    // first, and Ctrl+C never bubbles.
    in property <bool> forward-copy-chords: false;

    in-out property <string> text <=> input.text;
    // The height the content wants, so a caller can simply omit `height` and let the field hug its
    // own text. Callers used to do `max(32px, self.content-height + 16px)` by hand and each guessed
    // a different pair of numbers, which is why one card grew far taller than the line inside it.
    min-height: input.preferred-height + root.pad * 2;
    out property <bool> has-focus: input.has-focus;
    out property <length> content-height: input.preferred-height;

    callback edited();
    callback accepted();
    // A copy chord arrived while `forward-copy-chords` is on. Arguments: whether this field currently
    // holds a text selection, and whether the chord is the unconditional image one (Ctrl+Enter).
    //
    // It RETURNS whether the caller consumed it. That return value is what keeps the text-vs-image
    // rule in exactly one place: this component asks and obeys, it never decides. `false` means
    // "not mine", and the event is rejected so `TextInput` performs its own native copy - which is
    // also why nothing here calls `copy()` by hand and no double copy is possible.
    callback copy-chord-pressed(bool, bool) -> bool;

    changed has-focus => {
        if (root.commit-on-blur && !root.has-focus) {
            root.accepted();
        }
    }

    public function focus-input() {
        input.focus();
    }

    background: root.flat
        ? (input.has-focus ? Theme.bg-app : (touch.has-hover ? Theme.bg-hover : transparent))
        : Theme.bg-app;
    border-radius: Theme.radius-sharp;
    // The border is the only thing focus changes. The fill, the border and the placeholder are all
    // visible BEFORE any interaction, because the styled widget this replaces only looked like
    // somewhere you could type once it already had focus - so the first thing the Reviewer saw was a
    // blank strip they had no reason to click.
    border-width: root.flat ? (input.has-focus ? 2px : 0px) : (input.has-focus ? 2px : 1px);
    border-color: input.has-focus ? Theme.border-focus : Theme.border-strong;
    clip: true;

    // Only so a flat field can show it is one when the pointer is over it. A TouchArea declared
    // before the TextInput does not take the click away from it.
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
    }

    input := TextInput {
        read-only: root.read-only;
        x: root.pad;
        y: root.pad;
        // Explicit geometry, not inherited. A `Rectangle` child with no size fills its parent; this
        // is a built-in element and takes its preferred height, which is what lets the field grow
        // with a wrapped note.
        width: parent.width - root.pad * 2;
        font-size: root.text-size;
        font-family: root.mono ? "IBM Plex Mono" : "IBM Plex Sans";
        color: Theme.text-primary;
        selection-background-color: Theme.accent-primary;
        selection-foreground-color: Theme.text-on-accent;
        single-line: root.commit-on-enter;
        wrap: word-wrap;
        edited => {
            root.edited();
        }
        accepted => {
            root.accepted();
        }
        // Slint documents this callback as the hook for handling keys BEFORE `TextInput` does, which
        // is the only reason the overlay's copy chords can work at all while this field has focus.
        //
        // Ctrl+C does not arrive as the letter. It arrives as the ASCII control code ETX, which this
        // product already learned once - see `displayable_key_text` in `main.rs`, whose whole reason
        // for existing is "Ctrl+C's own text arriving as the ASCII control code rather than the
        // letter". The letter forms are matched too, in case a future Slint or another platform sends
        // those instead; matching only "c" is a shortcut that silently never fires.
        //
        // Selection state is `cursor-position-byte-offset != anchor-position-byte-offset`. Slint
        // marks both of those "Internal, undocumented property, only exposed for tests" in its own
        // `builtins.slint`. They are used deliberately: there is no public equivalent, and if a Slint
        // upgrade removes them this file fails to COMPILE rather than silently losing the behaviour,
        // which is the failure mode worth accepting.
        key-pressed(event) => {
            if (root.forward-copy-chords && event.modifiers.control && event.text == Key.Return) {
                root.copy-chord-pressed(false, true) ? accept : reject
            } else if (root.forward-copy-chords && event.modifiers.control
                    && (event.text == "\u{3}" || event.text == "c" || event.text == "C")) {
                root.copy-chord-pressed(
                    input.cursor-position-byte-offset != input.anchor-position-byte-offset,
                    false) ? accept : reject
            } else {
                reject
            }
        }
    }

    // Pinned to the same origin as the caret. The first attempt centred the placeholder vertically
    // while the text itself rendered from the top, so the grey prompt and the caret sat in visibly
    // different places.
    if root.text == "" : Text {
        x: root.pad;
        y: root.pad;
        width: parent.width - root.pad * 2;
        text: root.placeholder;
        font-size: root.text-size;
        font-family: "IBM Plex Sans";
        color: Theme.text-dim;
        wrap: word-wrap;
    }
}
