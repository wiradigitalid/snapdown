import { Theme } from "../theme.slint";

// One entry in a right-click menu.
//
// `separator` rather than a second element type, because a separator has to live in the same model
// as the items to keep its place in the list, and a model of two types is a model Slint cannot hold.
export struct MenuEntry {
    // What the callback receives. Empty on a separator.
    action: string,
    label: string,
    // A shortcut the same action already has elsewhere, shown right-aligned. `FR-37` says a menu is
    // a SECOND route to something, never the only one - this is where that shows.
    hint: string,
    separator: bool,
    enabled: bool,
}

// A right-click menu, drawn at a point.
//
// Not a `PopupWindow`: that opens a real window, which on Windows takes focus and drops the canvas's
// `FocusScope` - so Escape and Delete would stop working the moment a menu had been opened once. A
// plain Rectangle declared last is above everything, costs no window, and dismisses on any press
// outside itself.
export component SdContextMenu inherits Rectangle {
    in property <[MenuEntry]> entries;
    // Where the pointer was, in window coordinates.
    in property <length> at-x;
    in property <length> at-y;

    callback chosen(string);
    callback dismissed();

    private property <length> menu-width: 210px;
    private property <length> row-height: 28px;
    private property <length> separator-height: 7px;

    // The scrim is the dismissal. A menu that only closed on its own items would survive a click
    // meant for the canvas underneath, and the next click would land in a menu the Reviewer had
    // already stopped looking at.
    width: 100%;
    height: 100%;
    background: transparent;

    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { root.dismissed(); }
        }
    }

    Rectangle {
        // Flipped rather than clipped when it would leave the window: a menu opened near the right
        // edge otherwise loses the half of itself that carries the destructive item.
        x: Math.min(root.at-x, root.width - root.menu-width - 8px);
        y: Math.min(root.at-y, root.height - body.preferred-height - 8px);
        width: root.menu-width;
        height: body.preferred-height;
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: Theme.radius-sharp;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.overlay-shadow;

        // Swallows the press so it does not reach the scrim behind and dismiss before the item's own
        // click is delivered.
        TouchArea { }

        body := VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;

            for entry in root.entries : Rectangle {
                height: entry.separator ? root.separator-height : root.row-height;
                background: !entry.separator && entry.enabled && item-touch.has-hover
                    ? Theme.bg-hover
                    : transparent;

                if entry.separator : Rectangle {
                    y: (parent.height - 1px) / 2;
                    x: 8px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: Theme.border-subtle;
                }

                if !entry.separator : HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: entry.label;
                        font-size: 12px;
                        color: entry.enabled ? Theme.text-primary : Theme.text-dim;
                        vertical-alignment: center;
                        font-family: "IBM Plex Sans";
                        overflow: elide;
                    }

                    Text {
                        text: entry.hint;
                        font-size: 11px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                        font-family: "IBM Plex Mono";
                    }
                }

                item-touch := TouchArea {
                    // A separator is not a target, and neither is a disabled row - a menu that
                    // accepts a click on something it drew grey has told the Reviewer one thing and
                    // done another.
                    enabled: !entry.separator && entry.enabled;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.chosen(entry.action); }
                }
            }
        }
    }
}
