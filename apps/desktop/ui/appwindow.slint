// `ScrollView` only.
//
// `LineEdit`, `TextEdit` and `Button` all paint themselves from Slint's own style palette rather than
// from `theme.slint` - which is why the Observation Summary rendered white-on-white, and why the
// capture panel's Save action was a different size, colour and type scale from every button in the
// Editor. `SdTextField` and `SdActionButton` are this product's text entry and its actions,
// everywhere; importing the std-widget versions is how the drift got back in twice.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ReticleMarker } from "components/reticle-marker.slint";
import { CornerBrackets } from "components/corner-brackets.slint";
import { IconButton } from "components/icon-button.slint";
import { SdTextField } from "components/text-field.slint";
import { SdScrollBar } from "components/scrollbar.slint";
import { SdSlider } from "components/slider.slint";
import { SdContextMenu, MenuEntry } from "components/context-menu.slint";
import { SdIconLabel } from "components/icon-label.slint";
import { SdSettings, HotkeyRow } from "components/settings.slint";
import { SdSegmented, SegmentOption } from "components/form-controls.slint";
import { SdModalHeader } from "components/modal.slint";
import { SdActionButton, SdSectionLabel, SdCaption, SdDocHeading } from "components/action-button.slint";
import { AnnotationItem, AnnotationData } from "components/annotation.slint";
import { SdLibrary, LibraryBundleRow } from "components/library.slint";
import { SdReviewUpdate, ReviewUpdateBlock } from "components/review-update.slint";
import { SdReclaimSpace, ReclaimBundleRow } from "components/reclaim-space.slint";

import "../assets/fonts/IBMPlexSans-Medium.ttf";
import "../assets/fonts/IBMPlexSans-SemiBold.ttf";
import "../assets/fonts/IBMPlexSans-Bold.ttf";
import "../assets/fonts/IBMPlexMono-Regular.ttf";
import "../assets/fonts/IBMPlexMono-Medium.ttf";
import "../assets/fonts/IBMPlexMono-SemiBold.ttf";
import "../assets/fonts/IBMPlexMono-Bold.ttf";

export { Theme }
export { AnnotationData }
export { HotkeyRow }

export struct MarkerData {
    id: string,
    ordinal: int,
    x: float,
    y: float,
    comment: string,
}

// ONE BLOCK of the handoff document, as the Assemble preview shows it.
//
// A flat list rather than a Finding with nested notes and markers, because Slint carries a model
// inside a struct through a repeater badly - and because both views walk the same sequence. Preview
// renders each block; Code prints its markup and then the same editable text. That is what makes
// "edit in Code" work: the two are one document with two skins, not a render and a source dump.
//
// `kind` is one of: title · bundle-notes · finding · image · note · marker
export struct DocBlock {
    kind: string,
    finding-id: string,
    marker-id: string,
    // A Finding's position, or a Marker's ordinal.
    ordinal: int,
    text: string,
    // The image's Markdown reference, for the Code view.
    path: string,
    image: image,
    // True on the first Marker of a Finding, so `### Marker Notes` prints once above the list.
    starts-section: bool,
}

export struct FindingThumb {
    id: string,
    time-str: string,
    dimensions-str: string,
    is-selected: bool,
    is-active: bool,
    image: image,
}

// One monitor's bounds inside the overlay, in the snapshot's own physical pixel space.
export struct MonitorRectData {
    x: float,
    y: float,
    width: float,
    height: float,
}

// ONE overlay window covering the whole virtual desktop.
//
// It used to be one window per monitor, to give each its own DPI. That solved the mixed-DPI
// rendering but bought a class of multi-window defects: each window has its own renderer to warm
// up (a visible blink on the first pointer move of every capture) and its own event-loop turn, so
// closing them was never simultaneous - cancelling appeared to clear only one screen.
//
// A single window costs nothing in quality. For a per-monitor-DPI-aware process a window's
// surface maps 1:1 onto desktop pixels, so a snapshot at native physical resolution drawn
// full-bleed into a window sized in physical pixels is pixel-exact on every monitor, whatever
// their scale factors. The earlier single-window attempt looked zoomed because the window was
// sized wrongly, not because one window cannot span two DPIs.
//
// What the monitor list is still needed for: confining the crosshair to the screen under the
// pointer, and clamping a selection to that screen so a region can never span two monitors.
export component CaptureOverlayWindow inherits Window {
    title: "Snapdown Capture Overlay";
    no-frame: true;
    always-on-top: true;
    // Deliberately opaque, not transparent. The frozen screenshot below covers every pixel of
    // this window, so transparency buys nothing - and it costs: a transparent no-frame window is
    // a layered, per-pixel-alpha composited surface on Windows, whose first frame shows the live
    // desktop through it before the content lands. That read as a flicker on reveal.
    background: Theme.overlay-canvas;

    in-out property <image> snapshot-image;
    in-out property <length> mouse-x: 0px;
    in-out property <length> mouse-y: 0px;
    in-out property <bool> is-dragging: false;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;
    in-out property <length> drag-current-x: 0px;
    in-out property <length> drag-current-y: 0px;
    in-out property <bool> has-selection: false;
    in-out property <length> sel-x: 0px;
    in-out property <length> sel-y: 0px;
    in-out property <length> sel-w: 0px;
    in-out property <length> sel-h: 0px;
    in-out property <string> note-text: "";
    in-out property <bool> is-narrating: false;

    // Each monitor's bounds inside the snapshot, in snapshot (physical) pixels.
    in-out property <[MonitorRectData]> monitors: [];

    // Whether the pointer has slowed enough for the lens to be worth showing. Driven by the tick
    // timer near the bottom of this component.
    property <bool> pointer-settled: false;
    property <length> tick-x: 0px;
    property <length> tick-y: 0px;
    property <int> fast-ticks: 0;
    // Distance per 100ms tick. Below the first the lens appears; above the second it goes away;
    // between them the current state is kept. That band is the tolerance - roughly 200 to 700 px/s.
    property <length> settle-slow: 20px;
    property <length> settle-fast: 70px;

    // Below this drag distance, a press+release is a click, not a region selection.
    property <length> click-threshold: 4px;

    // Snapshot pixels per logical pixel. The snapshot is the desktop's physical resolution while
    // the window is measured in logical pixels, so this is the window's scale factor - derived
    // here rather than passed in, so it cannot fall out of step with the actual geometry.
    property <float> source-scale: (root.width > 0px && root.snapshot-image.width > 0)
        ? root.snapshot-image.width / (root.width / 1px)
        : 1.0;

    // The pointer, in snapshot pixels - the space the monitor rectangles are expressed in.
    property <float> pointer-src-x: root.mouse-x / 1px * root.source-scale;
    property <float> pointer-src-y: root.mouse-y / 1px * root.source-scale;

    function monitor-holds(m: MonitorRectData, px: float, py: float) -> bool {
        return px >= m.x && px < m.x + m.width && py >= m.y && py < m.y + m.height;
    }

    // The monitor containing an arbitrary point, given in SNAPSHOT pixels.
    //
    // Takes the point as arguments rather than reading the pointer, because two different things
    // need this answer about two different points: the crosshair and the full-screen control follow
    // the POINTER, while the note panel must be clamped to the monitor holding the SELECTION - the
    // pointer moves onto that panel and may cross to another screen while it is open.
    //
    // Slint's `for` is an element repeater, not a statement usable inside a function, so the
    // (realistically 1-4 entry) list is probed by index. Falls back to the whole desktop, so
    // nothing is ever left unplaced.
    function monitor-at(px: float, py: float) -> MonitorRectData {
        if (root.monitors.length > 0 && monitor-holds(root.monitors[0], px, py)) {
            return root.monitors[0];
        }
        if (root.monitors.length > 1 && monitor-holds(root.monitors[1], px, py)) {
            return root.monitors[1];
        }
        if (root.monitors.length > 2 && monitor-holds(root.monitors[2], px, py)) {
            return root.monitors[2];
        }
        if (root.monitors.length > 3 && monitor-holds(root.monitors[3], px, py)) {
            return root.monitors[3];
        }
        return {
            x: 0,
            y: 0,
            width: root.snapshot-image.width,
            height: root.snapshot-image.height,
        };
    }

    function active-monitor() -> MonitorRectData {
        return root.monitor-at(root.pointer-src-x, root.pointer-src-y);
    }

    // The monitor under the pointer, in this window's logical pixels. Used ONLY to lay the
    // crosshair out - it is deliberately not used to bound the selection.
    //
    // A region IS allowed to span monitors, which is what Snagit does: the drag is bounded by the
    // canvas, not by a monitor. Where the desktop is not rectangular the canvas has no pixels, so
    // such a region simply carries black in the gap - the same result Snagit produces, and it
    // falls out of the canvas being the desktop's bounding box rather than needing any code.
    property <length> crosshair-x: root.active-monitor().x / root.source-scale * 1px;
    property <length> crosshair-y: root.active-monitor().y / root.source-scale * 1px;
    property <length> crosshair-w: root.active-monitor().width / root.source-scale * 1px;
    property <length> crosshair-h: root.active-monitor().height / root.source-scale * 1px;
    // The lens shows exactly `loupe-pixels` SOURCE pixels across its face, and draws one grid cell
    // per source pixel - so a cell IS a pixel of the screenshot, not a decoration laid over it. That
    // equality is what `loupe-source-size == loupe-pixels` buys, and it broke once when this was
    // scaled by `source-scale`: on a HiDPI display the lens read out more pixels than the grid drew
    // cells, and the boxes lined up with nothing.
    //
    // 20 pixels across a 96px face, both to the owner's specification: round, smaller than it was,
    // and with smaller cells. It was 16 across 144px, which made each cell 9px - big enough that the
    // lens read as a diagram rather than as glass over the picture.
    property <int> loupe-pixels: 20;
    property <int> loupe-source-size: root.loupe-pixels;

    // Everything about the lens is snapped to whole PHYSICAL pixels, and that is what the blurred
    // rows were about.
    //
    // A cell was `96px / 20 = 4.8px` LOGICAL, and this display runs at 1.5 - so the grid lines fell
    // at 7.2, 14.4, 21.6 physical pixels and the renderer antialiased each one across two of them.
    // Some rows landed near a boundary and read sharp, others landed mid-pixel and read blurred,
    // which is exactly the "kayak ada yang kabur di beberapa baris" the owner saw. The 1px lines
    // themselves had the same problem: 1 logical pixel is 1.5 physical, so every one of them was a
    // 50% smear by construction.
    //
    // So the cell is chosen as a whole number of physical pixels and converted back, the face
    // follows from it, and the line is exactly ONE physical pixel. Positions then fall on integers
    // at whatever scale the monitor happens to run.
    property <length> loupe-cell-target: 5px;
    property <length> loupe-cell:
        round(root.loupe-cell-target / 1px * root.source-scale) / root.source-scale * 1px;
    property <length> loupe-face: root.loupe-cell * root.loupe-pixels;
    property <length> loupe-line: 1px / root.source-scale;

    // Snaps a coordinate to a whole physical pixel. The lens's own origin needs it as much as the
    // grid does: the pointer arrives at fractional logical coordinates, so an unsnapped lens shifts
    // its whole content by a fraction of a physical pixel and blurs every line inside it at once.
    function snap(v: length) -> length {
        return round(v / 1px * root.source-scale) / root.source-scale * 1px;
    }

    // The top-left source pixel of the lens's view: a WHOLE pixel, clamped so the face stays filled
    // at the desktop's edges instead of running off the source.
    //
    // The previous attempt made this fractional and slid the image and the grid together by the
    // remainder, on the theory that the lattice had to MOVE to belong to the picture. It does not,
    // and the attempt made things worse: offsetting a magnified image by a fraction of a pixel
    // resamples it every frame, so the whole view shimmered as the mouse moved. Reverted rather than
    // built on.
    property <int> loupe-origin-x: clamp(
        floor(root.pointer-src-x) - root.loupe-pixels / 2,
        0,
        max(0, root.snapshot-image.width - root.loupe-pixels));
    property <int> loupe-origin-y: clamp(
        floor(root.pointer-src-y) - root.loupe-pixels / 2,
        0,
        max(0, root.snapshot-image.height - root.loupe-pixels));

    // Which cell holds the pixel under the pointer. Derived from the clamped origin rather than
    // assumed to be the middle one: in the outermost few pixels of the desktop the view cannot be
    // centred, and there the box has to follow the pixel rather than the pointer.
    property <int> loupe-cursor-col: clamp(
        floor(root.pointer-src-x) - root.loupe-origin-x, 0, root.loupe-pixels - 1);
    property <int> loupe-cursor-row: clamp(
        floor(root.pointer-src-y) - root.loupe-origin-y, 0, root.loupe-pixels - 1);

    // Selection is reported in SNAPSHOT pixels, not logical ones, so the caller can crop the
    // canvas directly without needing to know this window's scale factor.
    callback capture-completed(int, int, int, int, string);
    callback overlay-cancelled();

    // A copy chord: put the selected region on the clipboard and save NOTHING. No PNG in the Vault,
    // no Finding, no Note - the typed note is discarded on purpose, which is the whole difference
    // between this and `capture-completed`.
    //
    // Coordinates are SNAPSHOT pixels, exactly like `capture-completed`. The two trailing flags
    // describe the chord, not the outcome: whether the note field holds a text selection, and whether
    // the chord is the unconditional image one (Ctrl+Enter).
    //
    // It RETURNS whether Rust consumed it. `false` means the press was a text copy, and the note
    // field then rejects the event so `TextInput` copies its own selection natively. No `if` over
    // those two flags exists anywhere in this file: the rule is `copy_chord_target` in `main.rs` and
    // it exists once, where it can be tested.
    callback copy-chord(int, int, int, int, bool, bool) -> bool;

    // Which container the pointer is over, so a single click can take it (`FR-1`: "1-click
    // container selection").
    //
    // The search is in Rust rather than here because Slint's expression language has no loop, so a
    // function cannot walk a list of candidates. Coordinates in and out are CANVAS pixels, the same
    // space the selection is reported in, so nothing has to convert twice.
    //
    // `pure` is what lets it be used in the binding below; a zero width means "nothing here".
    pure callback target-at(int, int, int) -> MonitorRectData;
    pure callback target-count-at(int, int) -> int;

    // How far OUT through the containers under the pointer to look. 0 is the tightest one.
    //
    // The detection returns candidates smallest-first, which is what makes occlusion work and is also
    // what made a whole window unselectable: a panel inside an application always won, and there was
    // no way to ask for the application. The wheel walks outward; moving the pointer resets it,
    // because the candidates under a new point are a different list.
    property <int> target-level: 0;
    property <int> target-count: root.target-count-at(
        round(root.mouse-x / 1px * root.source-scale),
        round(root.mouse-y / 1px * root.source-scale));

    property <MonitorRectData> hover-target: root.target-at(
        round(root.mouse-x / 1px * root.source-scale),
        round(root.mouse-y / 1px * root.source-scale),
        root.target-level);
    property <bool> has-hover-target:
        !root.is-dragging && !root.has-selection && root.hover-target.width > 0;

    // Set by the full-screen control's own TouchArea through a `changed` handler rather than read
    // from it here, because an id can only be referenced after it is declared and that control has
    // to come last in the file to sit on top of the catch-all TouchArea.
    property <bool> fullscreen-hover: false;
    property <bool> fullscreen-preview:
        root.fullscreen-hover && !root.has-selection && !root.is-narrating;

    // What a click would take right now, in this window's logical pixels: the whole screen while the
    // full-screen control is hovered, otherwise the container under the pointer.
    //
    // ONE rectangle drives both the scrim cut-out and the outline, so the two can never disagree
    // about what is being offered - and hovering the full-screen control previews the screen without
    // a click, which is what the owner asked for: the offer appears on entering the control and is
    // withdrawn on leaving it.
    property <bool> has-preview: root.fullscreen-preview || root.has-hover-target;
    property <length> preview-x: root.fullscreen-preview
        ? root.crosshair-x : root.hover-target.x / root.source-scale * 1px;
    property <length> preview-y: root.fullscreen-preview
        ? root.crosshair-y : root.hover-target.y / root.source-scale * 1px;
    property <length> preview-w: root.fullscreen-preview
        ? root.crosshair-w : root.hover-target.width / root.source-scale * 1px;
    property <length> preview-h: root.fullscreen-preview
        ? root.crosshair-h : root.hover-target.height / root.source-scale * 1px;

    // The monitor the SELECTION sits on, in logical pixels - the box the note panel is clamped
    // inside. Derived from the selection, never from the pointer: see `monitor-at`.
    property <MonitorRectData> panel-monitor: root.monitor-at(
        root.sel-x / 1px * root.source-scale,
        root.sel-y / 1px * root.source-scale);
    property <length> panel-mon-x: root.panel-monitor.x / root.source-scale * 1px;
    property <length> panel-mon-y: root.panel-monitor.y / root.source-scale * 1px;
    property <length> panel-mon-w: root.panel-monitor.width / root.source-scale * 1px;
    property <length> panel-mon-h: root.panel-monitor.height / root.source-scale * 1px;

    // Focus has to be re-claimed at the start of every capture, not just once.
    //
    // `init` below fires exactly once, because this overlay is created at start-up and reused
    // forever. Anything that took focus during an earlier capture - the note field, the Save button
    // - still had it on the next one, so Enter went nowhere. Escape kept working because the note
    // field REJECTS it and it bubbles up to the scope; Enter does not bubble, which is precisely
    // why Enter was the key that intermittently did nothing.
    public function claim-focus() {
        key-handler.focus();
    }

    key-handler := FocusScope {
        width: 100%;
        height: 100%;

        // Escape and Enter are both promised by the hint text under the note field, so both must
        // work wherever the keyboard focus happens to be. Enter used to be handled ONLY by the
        // note field's own `accepted`, so it worked while that field had focus and did nothing
        // otherwise - which is most of the time, because dragging a region moves focus away.
        //
        // When the note field DOES have focus it consumes Enter itself and this never sees it, so
        // there is no double-save.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.overlay-cancelled();
                accept
            } else if ((event.text == Key.Return || event.text == "\u{3}"
                        || event.text == "c" || event.text == "C")
                    && event.modifiers.control && root.has-selection) {
                // The copy chords, for when focus is NOT in the note field - the Save button has it,
                // say, or the panel is not up yet. `force-image` is true because there is no text
                // field in play here, so there is nothing a text copy could even mean.
                root.copy-chord(
                    round(sel-x / 1px * root.source-scale),
                    round(sel-y / 1px * root.source-scale),
                    round(sel-w / 1px * root.source-scale),
                    round(sel-h / 1px * root.source-scale),
                    false,
                    true
                );
                accept
            } else if (event.text == Key.Return && root.has-selection) {
                root.capture-completed(
                    round(sel-x / 1px * root.source-scale),
                    round(sel-y / 1px * root.source-scale),
                    round(sel-w / 1px * root.source-scale),
                    round(sel-h / 1px * root.source-scale),
                    root.note-text
                );
                accept
            } else {
                reject
            }
        }

        init => {
            self.focus();
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.snapshot-image;
        }

        // The dim layer is built as four rectangles AROUND the selection, leaving the selected
        // region showing the one full-bleed screenshot above, undimmed.
        //
        // Do not "optimise" this into a static scrim plus a re-clipped copy of the image drawn
        // over it. That was tried: `source-clip-*` are integer SOURCE-pixel properties while the
        // selection sits at fractional logical coordinates (scale 1.5 / 1.75), so the cut-out's
        // contents snap to whole source pixels while its frame moves smoothly - the image inside
        // the selection visibly slides against the backdrop as you drag. Leaving one image and
        // dimming around it is aligned by construction, and correctness wins here.
        //
        // Gated with `visible` rather than `if` so neither subtree is torn down and rebuilt; a
        // freshly built subtree presents one frame with no content, which reads as a blink.
        Rectangle {
            visible: !root.has-selection && !root.has-preview;
            width: 100%;
            height: 100%;
            background: Theme.overlay-scrim;
        }

        // The same four-rectangles construction as the selection below, applied to whatever a click
        // would take right now - the container under the pointer, or the whole screen while the
        // full-screen control is hovered.
        //
        // A previewed container used to be an outline plus a translucent wash drawn ON TOP of the
        // full scrim, so it stayed dimmed while a dragged region did not - two visual languages for
        // one idea, and the owner could not tell what a click was about to take. Cutting the scrim
        // instead means hovering previews exactly what selecting will look like.
        Rectangle {
            visible: root.has-preview;
            Rectangle { x: 0px; y: 0px; width: 100%; height: root.preview-y; background: Theme.overlay-scrim; }
            Rectangle { x: 0px; y: root.preview-y + root.preview-h; width: 100%; height: parent.height - (root.preview-y + root.preview-h); background: Theme.overlay-scrim; }
            Rectangle { x: 0px; y: root.preview-y; width: root.preview-x; height: root.preview-h; background: Theme.overlay-scrim; }
            Rectangle { x: root.preview-x + root.preview-w; y: root.preview-y; width: parent.width - (root.preview-x + root.preview-w); height: root.preview-h; background: Theme.overlay-scrim; }
        }
        Rectangle {
            visible: root.has-selection;
            Rectangle { x: 0px; y: 0px; width: 100%; height: sel-y; background: Theme.overlay-scrim; }
            Rectangle { x: 0px; y: sel-y + sel-h; width: 100%; height: parent.height - (sel-y + sel-h); background: Theme.overlay-scrim; }
            Rectangle { x: 0px; y: sel-y; width: sel-x; height: sel-h; background: Theme.overlay-scrim; }
            Rectangle { x: sel-x + sel-w; y: sel-y; width: parent.width - (sel-x + sel-w); height: sel-h; background: Theme.overlay-scrim; }
        }
        Rectangle {
            visible: root.has-selection;
            x: sel-x;
            y: sel-y;
            width: sel-w;
            height: sel-h;
            border-color: Theme.overlay-ring;
            border-width: 2px;
            background: transparent;

            Rectangle {
                y: -24px;
                x: 0px;
                height: 20px;
                width: 90px;
                border-radius: Theme.radius-sharp;
                background: Theme.accent-primary;
                Text {
                    // SOURCE pixels, which is what gets saved. It read `sel-w / 1px` - LOGICAL
                    // pixels - so on a 175% display it under-reported the region by 1.75x while
                    // every number downstream was physical.
                    text: round(sel-w / 1px * root.source-scale)
                        + " × " + round(sel-h / 1px * root.source-scale);
                    color: Theme.text-on-accent;
                    font-size: 11px;
                    font-weight: 700;
                    font-family: "IBM Plex Mono";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

        }

        // The crosshair, confined to the monitor the pointer is over rather than running the full
        // width and height of the desktop - which is the behaviour the owner asked for, and what
        // Snagit does.
        //
        // Gated with `visible`, deliberately NOT with `if`. An `if` creates and destroys the
        // element subtree, and the first paint of a freshly built subtree presented one frame
        // with the window's clear colour and no image, which read as a black blink. `visible`
        // keeps the elements alive and merely stops drawing them.
        // The crosshair. It is the pointer: the OS cursor is hidden (see `mouse-cursor` on the
        // catch-all TouchArea below), so these lines are what the Reviewer aims with.
        //
        // Confined to the monitor the pointer is over rather than running the full width and height
        // of the desktop, which is the behaviour the owner asked for and what Snagit does.
        //
        // Gated with `visible`, deliberately NOT with `if`. An `if` creates and destroys the element
        // subtree, and the first paint of a freshly built subtree presented one frame with the
        // window's clear colour and no image, which read as a black blink. `visible` keeps the
        // elements alive and merely stops drawing them.
        Rectangle {
            visible: !root.is-narrating && hover-tracker.has-hover;
            Rectangle {
                x: root.snap(mouse-x);
                y: root.crosshair-y;
                width: root.loupe-line;
                height: root.crosshair-h;
                background: Theme.overlay-ring.with-alpha(0.85);
            }
            Rectangle {
                x: root.crosshair-x;
                y: root.snap(mouse-y);
                width: root.crosshair-w;
                height: root.loupe-line;
                background: Theme.overlay-ring.with-alpha(0.85);
            }
        }

        // The pixel lens: a round magnifier BESIDE the pointer, showing the pixel under it at the
        // centre of its own crosshair.
        //
        // Beside, not centred on the pointer. Centred was tried, on a reading of "the boxes should be
        // on the canvas" that turned out to be about something else; a lens sitting on top of the
        // thing being aimed at hides it. The owner's specification is explicit: "jangan pas di
        // tengah2 crosshair ... ada magnifying glass di dekat situ, dan magnifying glass itu
        // tengahnya adalah crosshair juga."
        //
        // It appears only once the pointer SETTLES, which is Snagit's behaviour and the owner's
        // request - a magnifier that chases a fast pointer is noise, and the one thing nobody needs
        // while crossing the screen is a 96px disc in the way.
        //
        // The magnifier is NOT the source of the one-frame stall on the first pointer move of each
        // capture: hiding it entirely was tried and the stall remained.
        Rectangle {
            visible: !root.is-narrating && hover-tracker.has-hover && root.pointer-settled;
            // Beside the pointer, flipping to the other side near the monitor's edge so the lens
            // stays on the screen it belongs to.
            x: root.snap((root.mouse-x + 18px + root.loupe-face > root.crosshair-x + root.crosshair-w)
                ? root.mouse-x - 18px - root.loupe-face
                : root.mouse-x + 18px);
            y: root.snap((root.mouse-y + 18px + root.loupe-face > root.crosshair-y + root.crosshair-h)
                ? root.mouse-y - 18px - root.loupe-face
                : root.mouse-y + 18px);
            width: root.loupe-face;
            height: root.loupe-face;
            // Round, to specification. It costs the outermost cells, which the mask cuts into
            // slivers - accepted, because the pixel that matters is the one at the centre.
            border-radius: root.loupe-face / 2;
            border-width: 2px;
            border-color: Theme.overlay-ring;
            background: Theme.overlay-canvas;
            clip: true;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.overlay-shadow;

            // Only the small square under the cursor is read out of the screenshot, via source-clip.
            //
            // It used to lay out the ENTIRE screenshot at 3x (`width: root.width * 3`) and rely on
            // `clip: true` to show a 96px window onto it. On a 3840x2160 monitor that asks the
            // renderer for a ~75-megapixel scaled image on every pointer move, which is what made
            // the overlay flicker while the mouse moved and then settle once the renderer had
            // finally cached that texture. That is also the measurement that ruled out `pixelated`,
            // and the reason it no longer applies - see OQ-28.
            Image {
                width: root.loupe-face;
                height: root.loupe-face;
                source: root.snapshot-image;
                image-fit: fill;
                // Nearest-neighbour, so a source pixel is a solid block rather than a smear. Three
                // earlier attempts drew a lattice over a SMOOTHLY interpolated image, where there
                // are no pixels for a grid to belong to - which is why the grid kept reading as part
                // of the glass.
                image-rendering: pixelated;
                source-clip-width: root.loupe-source-size;
                source-clip-height: root.loupe-source-size;
                // Whole source pixels, so each block lands on a cell boundary.
                source-clip-x: root.loupe-origin-x;
                source-clip-y: root.loupe-origin-y;
            }

            // A separator between blocks that are now actually there, rather than a lattice standing
            // in for pixels that were not.
            for i in root.loupe-pixels : Rectangle {
                x: i * root.loupe-cell;
                y: 0px;
                width: root.loupe-line;
                height: root.loupe-face;
                background: Theme.overlay-grid;
            }
            for i in root.loupe-pixels : Rectangle {
                x: 0px;
                y: i * root.loupe-cell;
                width: root.loupe-face;
                height: root.loupe-line;
                background: Theme.overlay-grid;
            }

            // The lens's own crosshair, crossing on the pixel under the pointer.
            //
            // Placed from the CLAMPED origin rather than at the geometric centre: in the outermost
            // few pixels of the desktop the view cannot be centred, and there the crosshair has to
            // follow the pixel rather than the frame.
            Rectangle {
                x: root.loupe-cursor-col * root.loupe-cell
                    + (root.loupe-cell - root.loupe-line) / 2;
                y: 0px;
                width: root.loupe-line;
                height: root.loupe-face;
                background: Theme.overlay-ring;
            }
            Rectangle {
                x: 0px;
                y: root.loupe-cursor-row * root.loupe-cell
                    + (root.loupe-cell - root.loupe-line) / 2;
                width: root.loupe-face;
                height: root.loupe-line;
                background: Theme.overlay-ring;
            }
        }

        // Which pixel that crosshair is on, in desktop coordinates - beside the lens rather than
        // inside it, so it cannot sit under the pointer it is describing.
        Rectangle {
            visible: !root.is-narrating && hover-tracker.has-hover && root.pointer-settled;
            x: root.mouse-x - self.width / 2;
            y: root.mouse-y + 18px + root.loupe-face + 6px;
            width: 100px;
            height: 20px;
            border-radius: Theme.radius-pill;
            background: Theme.overlay-chrome;
            border-width: 1px;
            border-color: Theme.overlay-chrome-border;
            Text {
                width: 100%;
                height: 100%;
                text: (root.loupe-origin-x + root.loupe-cursor-col)
                    + ", " + (root.loupe-origin-y + root.loupe-cursor-row) + " px";
                font-size: 10px;
                font-family: "IBM Plex Mono";
                color: Theme.overlay-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Says that the wheel widens the selection, and only while there is somewhere to widen to.
        //
        // The detection walks panels before windows, so the tightest candidate is usually a panel
        // and the Reviewer wanting the whole window has no way of knowing one exists. A hint is
        // cheaper than a preference and honest about what is available at this exact point.
        Rectangle {
            visible: root.has-preview && !root.fullscreen-preview && root.target-count > 1;
            x: root.preview-x + root.preview-w - self.width - 6px;
            y: max(root.preview-y - 26px, 6px);
            width: 168px;
            height: 20px;
            border-radius: Theme.radius-sharp;
            background: Theme.overlay-chrome;
            border-width: 1px;
            border-color: Theme.overlay-chrome-border;
            Text {
                width: 100%;
                height: 100%;
                text: "Scroll to widen  ·  " + (root.target-level + 1) + " / " + root.target-count;
                font-size: 10px;
                font-family: "IBM Plex Sans";
                color: Theme.overlay-text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // The container under the pointer, outlined so it is obvious what a click would take.
        //
        // Gated with `visible` rather than `if`, like everything else in this overlay: building and
        // tearing down a subtree presents one frame of the window's clear colour, which reads as a
        // blink (`BUG-27`).
        Rectangle {
            visible: root.has-preview;
            x: root.preview-x;
            y: root.preview-y;
            width: root.preview-w;
            height: root.preview-h;
            background: transparent;
            border-width: 2px;
            border-color: Theme.overlay-ring;
            border-radius: 2px;
        }

        hover-tracker := TouchArea {
            width: 100%;
            height: 100%;
            // The OS cursor is hidden only while the crosshair is standing in for it.
            //
            // Hiding it unconditionally was wrong and shipped: the crosshair is drawn only while
            // `!is-narrating`, so once a region was selected there was no pointer on screen at all -
            // it reappeared over the note panel and nowhere else, because that panel's own TouchArea
            // restores the default. The Reviewer was aiming at a Save button they could not see.
            //
            // The condition is deliberately the crosshair's own visibility condition, not a
            // separately-reasoned one, so the two cannot drift apart again.
            mouse-cursor: root.is-narrating ? MouseCursor.default : MouseCursor.none;
            // Enabled throughout, INCLUDING while a note is being written.
            //
            // It used to be `enabled: !root.is-narrating`, because the note panel was nested inside
            // the selection frame and therefore sat under this TouchArea, which swallowed every
            // click meant for the note field. The panel is now declared after this element, so it
            // receives its own clicks - and leaving this enabled is what lets a click somewhere else
            // start a new selection instead of forcing Escape and a fresh capture.
            pointer-event(event) => {
                root.mouse-x = self.mouse-x;
                root.mouse-y = self.mouse-y;

                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.is-dragging = true;
                    root.drag-start-x = self.mouse-x;
                    root.drag-start-y = self.mouse-y;
                    root.drag-current-x = self.mouse-x;
                    root.drag-current-y = self.mouse-y;
                    root.has-selection = false;
                    root.is-narrating = false;
                    // The SIZE has to go too, not just the flag.
                    //
                    // Leaving sel-w/sel-h behind is what made a plain click select the wrong thing:
                    // on release, the "was this a drag or a click" test reads sel-w/sel-h, so with
                    // the previous drag's size still in them a click looked like a drag and re-armed
                    // the OLD region - while the blue outline had been showing the container the
                    // pointer was actually over.
                    root.sel-x = self.mouse-x;
                    root.sel-y = self.mouse-y;
                    root.sel-w = 0px;
                    root.sel-h = 0px;
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                    root.is-dragging = false;
                    // A plain click - no meaningful drag distance - takes the container under the
                    // pointer if there is one, and otherwise clears the selection. Dragging still
                    // wins whenever the pointer actually travelled.
                    if (root.sel-w < root.click-threshold || root.sel-h < root.click-threshold) {
                        if (root.hover-target.width > 0) {
                            root.sel-x = root.hover-target.x / root.source-scale * 1px;
                            root.sel-y = root.hover-target.y / root.source-scale * 1px;
                            root.sel-w = root.hover-target.width / root.source-scale * 1px;
                            root.sel-h = root.hover-target.height / root.source-scale * 1px;
                            root.has-selection = true;
                            root.is-narrating = true;
                        } else {
                            root.has-selection = false;
                            root.is-narrating = false;
                        }
                    } else {
                        root.has-selection = true;
                        root.is-narrating = true;
                    }
                }
                if (event.kind == PointerEventKind.cancel) {
                    root.overlay-cancelled();
                }
            }

            // The wheel walks outward through the containers under the pointer, and back in.
            //
            // Clamped rather than wrapped: wrapping means one notch too many silently returns to the
            // panel you were trying to escape, which is indistinguishable from the wheel not working.
            scroll-event(event) => {
                if (!root.is-dragging && !root.has-selection && !root.is-narrating) {
                    if (event.delta-y < 0) {
                        root.target-level = min(root.target-level + 1, max(0, root.target-count - 1));
                    } else if (event.delta-y > 0) {
                        root.target-level = max(root.target-level - 1, 0);
                    }
                    accept
                } else {
                    reject
                }
            }

            moved => {
                // A new point has a different candidate list, so the level cannot carry over.
                if (!root.is-dragging) {
                    root.target-level = 0;
                }
                if (root.is-dragging) {
                    // Bounded by the canvas - the whole desktop - so a region may span monitors.
                    // It must still not escape the canvas, or the crop would index outside the
                    // snapshot.
                    root.drag-current-x = clamp(self.mouse-x, 0px, root.width);
                    root.drag-current-y = clamp(self.mouse-y, 0px, root.height);
                    root.sel-x = min(root.drag-start-x, root.drag-current-x);
                    root.sel-y = min(root.drag-start-y, root.drag-current-y);
                    root.sel-w = abs(root.drag-current-x - root.drag-start-x);
                    root.sel-h = abs(root.drag-current-y - root.drag-start-y);
                    root.has-selection = true;
                }
            }
        }

        // The lens appears when the pointer SETTLES and hides while it travels, which is Snagit's
        // behaviour and what the owner asked for.
        //
        // Sampled on a fixed tick rather than accumulated per `moved` event: mouse event rates differ
        // by device and by how busy the frame is, so a per-event distance threshold means a different
        // speed on every machine. Comparing position against the position one tick ago is a real
        // velocity in px/s - here, roughly 240 px/s.
        //
        // `running` is tied to the tracker's hover, so this does not tick while the overlay is
        // sitting hidden between captures. It is declared after the tracker because a Slint id
        // resolves backwards only.
        Timer {
            interval: 100ms;
            running: hover-tracker.has-hover;
            triggered => {
                // TWO thresholds, not one, and a two-tick delay before hiding.
                //
                // One threshold with a binary flip is a comparator without hysteresis: hold the
                // pointer anywhere near the boundary and consecutive ticks land on opposite sides of
                // it, so the lens blinks. That is exactly what the owner saw - "saya pelan, tapi
                // kadang hilang, kadang muncul".
                //
                // Now: below `settle-slow` it appears, above `settle-fast` it goes away, and BETWEEN
                // the two nothing changes. A pointer drifting in that band keeps whatever state it
                // had, which is the tolerance that was missing. Hiding also needs two consecutive
                // fast ticks, so one jerk of the wrist does not dismiss it.
                if (abs(root.mouse-x - root.tick-x) + abs(root.mouse-y - root.tick-y)
                        > root.settle-fast) {
                    root.fast-ticks += 1;
                    if (root.fast-ticks >= 2) {
                        root.pointer-settled = false;
                    }
                } else {
                    root.fast-ticks = 0;
                    if (abs(root.mouse-x - root.tick-x) + abs(root.mouse-y - root.tick-y)
                            < root.settle-slow) {
                        root.pointer-settled = true;
                    }
                }
                root.tick-x = root.mouse-x;
                root.tick-y = root.mouse-y;
            }
        }

        // A one-click full-screen target, in the top-right corner of the monitor the pointer is on
        // (`FR-1`: "1-click container selection" - a whole screen is the container people take most).
        //
        // A CORNER, not the middle of the top edge, where it used to be: a control in the middle of
        // that edge stands in the way of a drag that starts there, and the owner asked for "paling
        // pojok di atas".
        //
        // Hovering it PREVIEWS the whole screen - the scrim opens and the ring appears - so the
        // offer is visible before committing to it, and taking the pointer away withdraws the offer.
        // No click is needed to see what you would get.
        //
        // Declared AFTER the catch-all TouchArea: Slint puts later siblings on top, and the
        // catch-all covers the whole desktop, so anything before it never receives a click. That
        // ordering is enforced by the compiler as well as by taste, since this reads ids declared
        // above it.
        //
        // Its visibility deliberately does NOT depend on `hover-tracker.has-hover`. It used to, and
        // this control sits ON TOP of that TouchArea - so moving the pointer onto the control took
        // the hover away from the tracker, which hid the control, which handed the hover back. That
        // oscillation is the flicker the owner saw, and it was in the visibility condition rather
        // than anywhere near the rendering.
        Rectangle {
            visible: !root.has-selection && !root.is-narrating;
            // TOP CENTRE of the monitor under the pointer, at the owner's direction. It was in the
            // corner first, on the argument that the middle of the top edge stands in the way of a
            // drag that starts there; the owner asked for the centre twice, so the centre it is, and
            // the cost is small - pressing the control takes the whole screen, which is a reasonable
            // outcome for a press in that spot anyway.
            x: root.crosshair-x + (root.crosshair-w - self.width) / 2;
            y: root.crosshair-y + 16px;
            width: 186px;
            height: 32px;
            // `radius-sharp`, the product's one corner radius for a control. This was `radius-pill`,
            // which no button in the Editor uses - the Assemble action, the toolbar buttons and the
            // tab strip are all sharp - so a pill here read as belonging to a different product.
            border-radius: Theme.radius-sharp;
            // Accent, not chrome. It was `overlay-chrome` - near-black - sitting on a 65% black
            // scrim, and the owner could not see that it was there at all. A control nobody notices
            // is a control that does not exist, which is the same failure as FR-1's affordance being
            // absent; the fix is contrast, not a bigger hit area.
            background: root.fullscreen-hover ? Theme.accent-hover : Theme.accent-primary;
            // No border. The Editor's accent buttons carry none, and a 1.5px light ring on an accent
            // fill is the detail that made this look bolted on rather than designed.
            border-width: 0px;
            drop-shadow-blur: 14px;
            drop-shadow-color: Theme.overlay-shadow;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;

                // Icon, then label, then readout: the same three-part shape as the Assemble action
                // in the filmstrip, at the same sizes - 12px glyph, 4-8px gap, small bold label.
                Image {
                    width: 13px;
                    height: 13px;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                    source: @image-url("../assets/icons/image.svg");
                    colorize: Theme.text-on-accent;
                }
                Text {
                    text: "Full Screen";
                    font-size: 11px;
                    font-weight: 700;
                    font-family: "IBM Plex Sans";
                    color: Theme.text-on-accent;
                    vertical-alignment: center;
                }
                // A hairline divider, the same device the status strip in the Editor uses to
                // separate a label from its readout.
                Rectangle {
                    width: 1px;
                    y: 9px;
                    height: parent.height - 18px;
                    background: Theme.text-on-accent.with-alpha(0.35);
                }
                Text {
                    // The monitor's own pixel count, straight out of the monitor rectangle - which
                    // is already in snapshot pixels, so nothing is converted and nothing can drift.
                    text: root.active-monitor().width + " × " + root.active-monitor().height;
                    font-size: 10px;
                    font-family: "IBM Plex Mono";
                    color: Theme.text-on-accent.with-alpha(0.8);
                    vertical-alignment: center;
                }
            }

            fullscreen-touch := TouchArea {
                // Pushed up to the root rather than read from here, because the properties that
                // depend on it are declared above this element and an id resolves backwards only.
                changed has-hover => {
                    root.fullscreen-hover = self.has-hover;
                }
                clicked => {
                    root.sel-x = root.crosshair-x;
                    root.sel-y = root.crosshair-y;
                    root.sel-w = root.crosshair-w;
                    root.sel-h = root.crosshair-h;
                    root.has-selection = true;
                    root.is-narrating = true;
                    root.fullscreen-hover = false;
                }
            }
        }

        // The note panel, at the TOP of the overlay's z-order rather than nested inside the
        // selection frame. Two separate things needed that move.
        //
        // Changing your mind: clicking somewhere else has to start a new selection without pressing
        // Escape first, and that means the catch-all TouchArea stays enabled while the note is being
        // written. Nested where it was, this panel sat UNDER that TouchArea, and every click meant
        // for the note field or the Save button was swallowed - which is why the TouchArea had to be
        // disabled in the first place.
        //
        // Staying on screen: nested, its position was expressed partly in the selection's coordinate
        // space and partly in the root's, and the flip-above test could only compare against
        // `root.height`. On a two-monitor desktop the canvas is the bounding box of both screens, so
        // its bottom edge is BELOW the shorter screen's - a panel that "fitted the canvas" was still
        // off the visible screen. That is the bug the previous attempt at this did not fix.
        if is-narrating : Rectangle {
            // Below the selection when there is room, above it when there is not, and then clamped
            // into the monitor either way.
            //
            // The flip is the preference and the clamp is the guarantee: with only a flip, a
            // selection taller than the screen has nowhere to put the panel and it leaves the
            // screen again. Clamped, it can at worst overlap the selection - and a panel over the
            // region beats a panel nobody can reach.
            y: clamp(
                (root.sel-y + root.sel-h + 12px + self.height > root.panel-mon-y + root.panel-mon-h)
                    ? root.sel-y - self.height - 12px
                    : root.sel-y + root.sel-h + 12px,
                root.panel-mon-y + 12px,
                max(root.panel-mon-y + 12px,
                    root.panel-mon-y + root.panel-mon-h - self.height - 12px));
            x: clamp(
                root.sel-x + (root.sel-w - self.width) / 2,
                root.panel-mon-x + 12px,
                max(root.panel-mon-x + 12px,
                    root.panel-mon-x + root.panel-mon-w - self.width - 12px));
            // 440px, the inspector's width, so a note wraps at the same line length in both places.
            // It was 360px, which is a number chosen for this panel alone - and the guide's own rule
            // is that the Editor is the reference where the two disagree.
            width: 440px;
            // Sized from its own contents. It used to be a fixed 110px, which was enough for a
            // one-line LineEdit and stopped being enough the moment the field grew - so the
            // hint text and the Save button were pushed out through the bottom edge.
            height: note-body.preferred-height;
            background: Theme.bg-card;
            border-radius: Theme.radius-sharp;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.overlay-shadow;

            // Absorbs clicks that land on the panel's own padding. Without it they fall through to
            // the catch-all TouchArea below and clear the very selection this panel is about - the
            // one cost of that TouchArea staying enabled during narration.
            TouchArea {
                width: 100%;
                height: 100%;
            }

            // The Editor inspector's spacing, to the pixel: 16px padding, 6px between a label and
            // the thing it labels. This panel had 14px and 10px, chosen in isolation, and that is
            // most of why it still read as a different product once the colours already matched.
            note-body := VerticalLayout {
                padding: 16px;
                spacing: 6px;
                // The same heading component the inspector uses - 11px/800, 0.5px letter-spacing,
                // upper case. It was 11px/700 in sentence case: two dialects for one idea, and
                // invisible until the two panels are seen side by side.
                SdSectionLabel {
                    text: "NOTES";
                }
                // The product's one text field. It was drawn by hand here first, which is
                // how the palette problem was found; it now lives in
                // `components/text-field.slint` and the Editor's Observation Summary is the
                // same component, so the two cannot drift apart.
                note-input := SdTextField {
                    // Grows with the note rather than clipping it, and never shorter than one
                    // comfortable line.
                    height: max(38px, note-input.content-height + 20px);
                    placeholder: "Describe what is wrong here...";
                    text <=> root.note-text;
                    // Enter saves, which is what the hint below promises.
                    commit-on-enter: true;
                    // Ctrl+C and Ctrl+Enter must keep working even though this field owns the
                    // keyboard from the moment the panel appears - see `init` below, and the comment
                    // on `forward-copy-chords` itself.
                    forward-copy-chords: true;
                    copy-chord-pressed(text-selected, force-image) => {
                        root.copy-chord(
                            round(sel-x / 1px * root.source-scale),
                            round(sel-y / 1px * root.source-scale),
                            round(sel-w / 1px * root.source-scale),
                            round(sel-h / 1px * root.source-scale),
                            text-selected,
                            force-image
                        )
                    }
                    // Takes focus the moment the popup exists.
                    //
                    // Nothing ever focused this field, so typing only worked if the Reviewer
                    // clicked it first. That was survivable while nothing else held the
                    // keyboard - and stopped being survivable when the window's FocusScope
                    // started re-claiming focus for every capture, because its key handler
                    // REJECTS every key except Escape and Enter. Keystrokes went nowhere and
                    // Enter then saved an empty note: the note was not lost in storage, it was
                    // never captured.
                    init => {
                        self.focus-input();
                    }
                    accepted => {
                        root.capture-completed(
                            round(sel-x / 1px * root.source-scale),
                            round(sel-y / 1px * root.source-scale),
                            round(sel-w / 1px * root.source-scale),
                            round(sel-h / 1px * root.source-scale),
                            root.note-text
                        );
                    }
                }
                // A little more air above the action than between a label and its field, which is
                // the inspector's own rhythm rather than a number picked here.
                Rectangle { height: 4px; }

                // Two lines, not one, and the second one is a promise made BEFORE the keystroke.
                //
                // The copy path leaves nothing behind on purpose, so the Reviewer has to know that
                // while deciding, not after acting. A toast fires afterwards too, but it lands on the
                // main window - which on the tray-only loop this product is built around may not
                // even be on screen. This line is the guaranteed half of that message.
                VerticalLayout {
                    spacing: 2px;
                    SdCaption {
                        text: "Enter to save · Esc to cancel";
                    }
                    SdCaption {
                        text: "Ctrl+C copies only — nothing is saved";
                    }
                }

                Rectangle { height: 6px; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    // Subordinate to Save Finding: saving is what this panel is for, copying is the
                    // shortcut out of it.
                    SdActionButton {
                        label: "Copy Only";
                        icon: @image-url("../assets/icons/copy.svg");
                        primary: false;
                        clicked => {
                            root.copy-chord(
                                round(sel-x / 1px * root.source-scale),
                                round(sel-y / 1px * root.source-scale),
                                round(sel-w / 1px * root.source-scale),
                                round(sel-h / 1px * root.source-scale),
                                false,
                                true
                            );
                        }
                    }
                    SdActionButton {
                        label: "Save Finding";
                        icon: @image-url("../assets/icons/camera.svg");
                        clicked => {
                            root.capture-completed(
                                round(sel-x / 1px * root.source-scale),
                                round(sel-y / 1px * root.source-scale),
                                round(sel-w / 1px * root.source-scale),
                                round(sel-h / 1px * root.source-scale),
                                root.note-text
                            );
                        }
                    }
                }
            }
        }
    }
}
export component AppWindow inherits Window {
    title: "Snapdown Editor";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: 6px;
    min-width: 1024px;
    min-height: 720px;
    preferred-width: 1366px;
    preferred-height: 860px;
    background: Theme.bg-app;
    default-font-family: "IBM Plex Sans";

    in-out property <bool> is-dark-theme <=> Theme.is-dark;

    out property <color> bg-app: Theme.bg-app;
    out property <color> bg-card: Theme.bg-card;
    out property <color> bg-subtle: Theme.bg-subtle;
    out property <color> bg-hover: Theme.bg-hover;
    out property <color> border-subtle: Theme.border-subtle;
    out property <color> border-strong: Theme.border-strong;
    out property <color> text-primary: Theme.text-primary;
    out property <color> text-secondary: Theme.text-secondary;
    out property <color> text-muted: Theme.text-muted;
    out property <color> text-dim: Theme.text-dim;

    in-out property <string> current-filename: "capture_20260826_041750.png";
    in-out property <int> active-tool-index: 0;
    in-out property <int> active-tab-index: 0;
    // No placeholder default. It used to read "test\n1. Marker 1\n2. Marker 2", which is content a
    // reader cannot tell from a real note - so a binding that never delivered looked like a note
    // that had been saved wrong. An empty default makes that failure visible instead (`BUG-45`).
    // The Finding's general note. Called the "Observation Summary" until 2026-08-27, in the
    // inspector and nowhere else - the document called it Notes, the capture panel asked "what is
    // wrong here?", and the per-Marker remarks were "Marker notes" in one place and "Marker
    // observations" in another. Four names for two things. The comments further down this file that
    // still say "Observation Summary" are describing what happened when it was called that, which is
    // history and stays true.
    in-out property <string> finding-note: "";
    // Which Finding the panel is showing, so an edit can be written to the right row.
    in-out property <string> active-finding-id: "";
    in-out property <int> selected-finding-count: 0;
    // The cost card's real inputs. The note's own length is read live in Slint with
    // `character-count`; these two cannot be, so Rust sets them: a sum over the Marker model has
    // no fold in Slint, and the image estimate needs the stored dimensions rather than the readout.
    in-out property <int> marker-char-count: 0;
    in-out property <int> image-token-estimate: 0;
    in-out property <string> resolution-text: "1020 × 885  px";
    in-out property <string> size-text: "119.5  KB";
    in-out property <image> active-image;
    // No demo Markers. Two fake ones used to ship as the default, for the same reason the
    // Observation Summary once shipped placeholder prose - and with the same consequence: a reader
    // cannot tell invented content from stored content, so a binding that never delivered looked
    // like data that had been saved wrong (`BUG-45`).
    in-out property <[MarkerData]> markers: [];
    in-out property <[FindingThumb]> filmstrip-items: [];

    // CANVAS ANNOTATIONS - `CAP-11`.
    //
    // A separate model from `markers` and not a superset of it, because the two are different
    // promises: a Marker produces a numbered line in the Markdown, and `FR-30` to `FR-32` say in the
    // PRD's own non-goals that an annotation produces none. They share a canvas and nothing else.
    in-out property <[AnnotationData]> annotations: [];
    // The active capture, blurred whole. Every Blur annotation - and the drag that is becoming one -
    // is a clipped window onto this. See `blurred_capture` in `main.rs`.
    in-out property <image> blurred-capture;
    // At most one, by id. An index would be wrong the moment an annotation is deleted, which is the
    // same trap the Shift-click anchor fell into (`BUG-67`).
    //
    // Set by RUST, never by the canvas, even though the click that changes it happens here. The
    // Properties panel lives in the inspector beside the Marker Notes, and a Slint repeater cannot
    // pick one row out of a model - so the five fields below are Rust's answer to "which one is
    // selected, and what does it say". Having the canvas write the id directly and Rust write the
    // rest would be two writers for one fact, and they would disagree the first time an annotation
    // was deleted.
    in-out property <string> selected-annotation-id: "";
    in-out property <string> selected-annotation-kind: "";
    in-out property <string> selected-annotation-text: "";
    in-out property <float> selected-annotation-font-size: 14;
    in-out property <string> selected-annotation-font-family: "IBM Plex Sans";
    in-out property <string> selected-annotation-align: "start";
    // Only a Text and a Callout carry words, and the owner scoped the panel to exactly those two.
    // A font size being dragged on the slider, not yet committed. Zero means nothing is.
    private property <float> live-font-size: 0;
    private property <bool> selected-has-words:
        root.selected-annotation-kind == "text" || root.selected-annotation-kind == "callout";

    // The drag in progress on the canvas. Never written to the store - `commit-drawing` turns it
    // into one `annotation-drawn` and it is gone.
    private property <bool> drawing: false;
    private property <float> draw-x1;
    private property <float> draw-y1;
    private property <float> draw-x2;
    private property <float> draw-y2;

    // Tool index to the kind it draws. The toolbar's indices are the ordinals the Reviewer sees
    // (`1`..`6` on the buttons), so this is the single place the two vocabularies meet.
    private property <string> active-tool-kind:
        root.active-tool-index == 1 ? "rect"
        : root.active-tool-index == 2 ? "callout"
        : root.active-tool-index == 3 ? "blur"
        : root.active-tool-index == 4 ? "arrow"
        : root.active-tool-index == 5 ? "text"
        : "";

    // A CLICK IS NOT A DRAWING.
    //
    // This used to invent a default-sized shape for a click that never became a drag. The owner
    // rejected it, and was right: *"Kalau cuma click pertama lalu lepas, maka jangan draw element.
    // Jangan ada default ukuran."* An annotation is a statement about a REGION, and a tap does not
    // name one - a default size would be the product guessing which region was meant.
    //
    // 8 image pixels in the longer direction. The canvas draws a Finding at natural size, so this is
    // measured in the image's own pixels and does not change with the window.
    private property <bool> drag-is-real:
        Math.max(Math.abs(root.draw-x2 - root.draw-x1) * root.active-image.width,
                 Math.abs(root.draw-y2 - root.draw-y1) * root.active-image.height) >= 8;

    // A Callout's gesture is the other way round from a box's: the FIRST point is the tail's target.
    //
    // *"mouse click pertama itu adalah anchor dari ekor callout, tinggal di geser aja mousenya agar
    // mengikuti besar callout dan posisi callout"* - so the press names the thing being pointed AT,
    // and the drag carries the bubble away from it, growing as it goes. The bubble takes the far 70%
    // of the drag so a visible tail always remains between the two.
    private property <float> callout-bubble-x1: root.draw-x1 + (root.draw-x2 - root.draw-x1) * 0.3;
    private property <float> callout-bubble-y1: root.draw-y1 + (root.draw-y2 - root.draw-y1) * 0.3;

    // A Text is at least one line tall.
    //
    // A drag that is 6 image pixels high cannot render an 18px line, so the words would be clipped
    // to nothing and the annotation would look empty. The canvas is the only place that knows the
    // image's own height, which is what the normalised height has to be measured against.
    //
    // 1.4x the font size: ascender to descender plus the 10px inset the field and the drawn text
    // both use, at the sizes the ladder offers.
    private property <float> text-min-height:
        root.active-image.height > 0
            ? (root.draw-preview.font-size * 1.4 + 20) / root.active-image.height
            : 0.0;

    function commit-drawing() {
        if (root.active-tool-kind == "" || !root.drag-is-real) {
            return;
        }
        if (root.active-tool-kind == "text") {
            root.annotation-drawn("text", root.draw-x1, root.draw-y1, root.draw-x2,
                // Grown DOWNWARD from wherever the drag started, so the top edge stays where the
                // Reviewer put it and only the unusable part of the height is corrected.
                Math.max(root.draw-y2, Math.min(root.draw-y1, root.draw-y2) + root.text-min-height));
            return;
        }
        // The RAW gesture, for every kind including a Callout. `shape_from_drag` owns the inset
        // that separates a Callout's bubble from its tail, so both halves are derived from the same
        // two points in one place. Sending the inset corner from here was what made the tail snap to
        // the bubble's own top-left the moment the drag ended.
        root.annotation-drawn(root.active-tool-kind,
            root.draw-x1, root.draw-y1, root.draw-x2, root.draw-y2);
    }

    // What the drag looks like WHILE it is happening: the real element, not a rehearsal.
    //
    // The preview used to be one neutral blue rectangle for all five tools. The owner asked for the
    // actual illustration - *"pas di click drag dia otomatis visual ilustrasi aslinya"* - and the way
    // to guarantee it matches is to feed the same `AnnotationItem` the committed ones use, rather
    // than draw a second approximation of each shape that could drift from it.
    private property <AnnotationData> draw-preview: {
        id: "",
        kind: root.active-tool-kind,
        x1: root.active-tool-kind == "callout" ? root.callout-bubble-x1 : root.draw-x1,
        y1: root.active-tool-kind == "callout" ? root.callout-bubble-y1 : root.draw-y1,
        x2: root.draw-x2,
        y2: root.draw-y2,
        tail-x: root.draw-x1,
        tail-y: root.draw-y1,
        text: "",
        // One size for both, matching `DEFAULT_ANNOTATION_FONT_SIZE`. They were 18 and 14, so a
        // Callout and a Text placed on the same capture did not match.
        font-size: 18,
        font-family: "IBM Plex Sans",
        text-align: "start",
    };

    // A transient result line for an action whose outcome is otherwise invisible. Assembling a
    // Bundle writes image files, a Markdown file and a database row and changes nothing on screen;
    // without this the owner cannot tell a success from a silent failure, which is exactly the
    // class of defect `BUG-19` and `BUG-23` are.
    in-out property <string> toast-text: "";
    in-out property <bool> toast-is-error: false;

    // THE ASSEMBLE PREVIEW.
    //
    // Assembling used to write the Bundle the instant the tile was clicked: files on disk, a database
    // row, a generated name, and the first sight of any of it was a folder in the Vault. `UC-9`'s own
    // screen - `04-bundle-assembly-modal.html` in `.how/bundle/01-ux/assets/` - has always specified
    // a review step, and the owner asked for it by name.
    //
    // Everything here is computed WITHOUT writing anything. `plan_bundle` already produced the whole
    // document in memory before touching the disk, so the preview is that plan shown rather than a
    // second rendering path that could disagree with it.
    in-out property <bool> bundle-preview-open: false;
    // EDIT and PREVIEW, and Edit is where the work happens.
    //
    // This was Preview and Code, with Code the editor - and the owner turned it round, correctly:
    // the title, the Bundle note, every Finding's note and every Marker's note are all edited in the
    // rendered view, so THAT is the editor. What is left for the raw CommonMark is to show what will
    // actually be handed over, which is a preview of the deliverable and is read-only.
    //
    // The alternative was to keep raw editing and render it back, which needs a Markdown parser this
    // product has no other use for - and until it had one, an edit in the raw view could not appear
    // in the rendered one. That mismatch is what the `Regenerate` button was papering over, and
    // "regenerate" was the wrong word for it anyway: it restored.
    in-out property <bool> bundle-preview-shows-source: false;
    in-out property <string> bundle-preview-markdown: "";
    in-out property <[DocBlock]> bundle-preview-blocks: [];
    // For the header's readout only. The document itself is `bundle-preview-blocks`.
    in-out property <int> bundle-preview-finding-count: 0;
    // Text only, and the label says so. An image costs an agent far more than its Markdown reference
    // and this cannot know how much, so it does not pretend to.
    in-out property <int> bundle-preview-text-tokens: 0;

    // THE LIBRARY (ticket 11 of the Bundle Library spec). Gated the same way `bundle-preview-open`
    // is: Rust sets it, Slint never flips it itself. `library-state` is "loading" | "error" |
    // "ready" - "ready" with an empty `library-rows` IS the empty state, so there is no fourth
    // value that would just restate `rows.length == 0` in a second place.
    in-out property <bool> library-open: false;
    in property <string> library-state: "loading";
    in property <string> library-error-message: "";
    in property <[LibraryBundleRow]> library-rows: [];

    // THE ROW MENU'S DESTRUCTIVE GROUP (ticket 16). Which single verb it offers - Disassemble… or
    // Delete… - is decided in Rust every time the menu opens, from a live read of whether the
    // Bundle's Findings still exist (`BR-122`). These properties are therefore only ever WRITTEN by
    // Rust; Slint reads them to draw the menu and never derives the verb itself.
    in property <string> library-menu-target: "";
    in property <bool> library-menu-sealed: false;
    in property <length> library-menu-x;
    in property <length> library-menu-y;
    callback library-row-menu-requested(string, length, length);
    callback library-row-menu-dismissed();
    callback library-row-menu-action(string, string);

    // THE TWO CONFIRMATIONS. Bundle name and Finding count are supplied by Rust fresh at the moment
    // a dialog opens - the same live read that decided the verb, never carried over from the row
    // list, which can be stale by the time a Reviewer's click actually lands.
    in property <string> library-pending-disassemble: "";
    in property <string> library-pending-delete: "";
    in property <string> library-pending-bundle-name: "";
    in property <int> library-pending-bundle-finding-count: 0;
    callback library-disassemble-cancelled();
    callback library-disassemble-confirmed(string);
    callback library-delete-cancelled();
    callback library-delete-confirmed(string);

    // REVIEW & UPDATE (`ticket 13` locked mode, `ticket 14` editing). Sits ABOVE the Library
    // (declared after it below), never closes it - `library-open` is left alone by every callback
    // here, which is what makes "Close returns to the Library with its scroll position intact" true
    // by construction: the Library's own `SdLibrary` instance, and its `ScrollView`'s state, are
    // never torn down.
    in-out property <bool> review-update-open: false;
    in property <[ReviewUpdateBlock]> review-update-blocks: [];
    in property <string> review-update-provenance: "";
    // Locked / Editing (`ticket 14`). Rust-driven both ways: `true` only after `edit-clicked`
    // successfully builds an in-memory buffer, `false` again only after Save completes or Cancel/
    // Discard gives up on it.
    in-out property <bool> review-update-editing: false;
    // The "discard changes?" confirmation. `in-out` so `SdReviewUpdate`'s own "Keep editing" can
    // dismiss it without a Rust round trip, two-way bound at the mount site below.
    in-out property <bool> review-update-cancel-pending: false;

    // DISCARD ORIGINALS and DELETE BOTH (`ticket 17`). `library-pending-discard-warning` names any
    // other Bundle that will also be sealed - Rust's own live read, forwarded straight through.
    in property <string> library-pending-discard: "";
    in property <string> library-pending-discard-warning: "";
    callback library-discard-cancelled();
    callback library-discard-confirmed(string);
    in property <string> library-pending-delete-both: "";
    callback library-delete-both-requested(string);
    callback library-delete-both-cancelled();
    callback library-delete-both-confirmed(string);

    // RECLAIM SPACE (`ticket 18`). Reached from two doors - a new entry beside the Library's own
    // Bundle count, and a new button in Settings' Vault card - both of which fire THIS one callback,
    // which is what makes "both open the same screen" true by construction. Gated the same way
    // `library-open` is: Rust sets it, Slint never flips it itself. Opening or closing this never
    // touches `library-open`/`settings-open`, so whichever screen was open underneath stays exactly
    // as it was.
    callback reclaim-space-clicked();
    in-out property <bool> reclaim-space-open: false;
    in property <[ReclaimBundleRow]> reclaim-space-rows: [];
    in property <string> reclaim-space-total-label: "";
    in property <string> reclaim-space-footer-label: "";
    in property <int> reclaim-space-selected-count: 0;
    callback reclaim-space-closed();
    callback reclaim-space-row-toggled(string);
    callback reclaim-space-discard-clicked();

    // THE BULK CONFIRMATION. `reclaim-space-pending-ids` carries the ticked Bundle ids from the
    // moment the confirmation opens through to the moment it is confirmed - an `in` property Rust
    // both writes (on `reclaim-space-discard-clicked`) and reads back (on
    // `reclaim-space-discard-confirmed`), the same round trip `library-pending-disassemble` makes
    // for one id, widened to a list.
    in property <bool> reclaim-space-confirm-open: false;
    in property <string> reclaim-space-confirm-heading: "";
    in property <string> reclaim-space-confirm-body: "";
    in property <[string]> reclaim-space-pending-ids: [];
    callback reclaim-space-discard-cancelled();
    callback reclaim-space-discard-confirmed();

    // id, ctrl held, shift held. One callback rather than two, because a click on a card is one
    // gesture whose MEANING depends on the modifiers - splitting it into "selected" and "toggled"
    // put the interpretation in the UI, where the anchor for a Shift range does not live.
    callback finding-clicked(string, bool, bool);
    callback finding-note-edited(string);
    callback library-clicked();
    callback library-closed();
    callback library-try-again-clicked();
    callback library-open-file-location-clicked();
    // Bundle id, forwarded from `SdLibrary`'s own row-level callbacks (`ticket 12`).
    callback library-copy-markdown-clicked(string);
    callback library-bundle-open-file-location-clicked(string);
    // A Library row was clicked - the Bundle's id. Opens Review & Update, locked.
    callback library-bundle-clicked(string);
    callback review-update-closed();
    // Ticket 14: Edit unlocks editing; every field edit forwards here as
    // (kind, finding-ordinal, marker-ordinal, text); Save and Cancel are their own callbacks because
    // each needs its own decision made in Rust (write ordering for Save, dirty-check for Cancel);
    // Discard is the "discard changes?" confirmation's own confirm action.
    callback review-update-edit-clicked();
    callback review-update-field-edited(string, int, int, string);
    callback review-update-save-clicked();
    callback review-update-cancel-clicked();
    callback review-update-discard-clicked();
    callback capture-clicked();
    callback open-file-clicked();
    callback paste-clicked();
    callback assemble-bundle-clicked();
    callback copy-image-clicked();
    callback marker-placed(float, float);
    callback delete-marker-clicked(string);
    callback marker-comment-edited(string, string);

    // ANNOTATIONS - `CAP-11`. Six callbacks, and every one of them is handled in `main.rs`:
    // `every_ui_callback_has_a_rust_handler_or_is_declared_unreachable` is what stops this becoming
    // `BUG-55` again, where six callbacks and a file dialog were declared and joined to nothing.
    //
    // kind, and the drag's two corners - normalized. Rust decides what shape a kind makes.
    callback annotation-drawn(string, float, float, float, float);
    // id, and the new two corners. One callback for a move, a resize and an arrow endpoint alike.
    callback annotation-geometry-changed(string, float, float, float, float);
    callback annotation-tail-moved(string, float, float);
    callback annotation-text-edited(string, string);
    // id, font size in IMAGE pixels, family, alignment. The Properties panel's three controls, sent
    // together because they are one form and a partial write would need three round trips.
    callback annotation-style-changed(string, float, string, string);
    callback annotation-deleted(string);
    // Selection goes THROUGH Rust so the Properties panel's five mirrored fields are written by the
    // same hand that writes the id. Pass "" to deselect.
    callback annotation-selected(string);
    // A Marker can be moved after it is placed. It could not be, and the owner asked for it:
    // *"marker maunya bisa digeser2 meskipun sudah ditaruh"*.
    callback marker-moved(string, float, float);
    // id, and one of `front` · `forward` · `backward` · `back`.
    callback annotation-reordered(string, string);
    // The three the archived Tauri menu had and this one did not. `copy-image-clicked` already
    // existed and was handled by nothing; it is handled now.
    callback delete-finding-confirmed(string);
    callback open-file-location-clicked(string);
    // The folder the Reviewer picked, awaiting confirmation. Moving a Vault touches every file the
    // product owns, so it asks first - the same reason deleting a Finding does.
    in-out property <string> pending-vault-folder: "";
    in-out property <int> pending-vault-file-count: 0;
    callback vault-migration-confirmed(string);

    // Deleting a Finding is irreversible - the row AND the file - so it is confirmed once.
    //
    // The Product Brief rejects a recycle bin in as many words and names the alternative:
    // "Confirmation once is the safety, not a bin." A menu item that deleted a capture on a single
    // click would be the one destructive action in this product with nothing between the pointer and
    // the disk.
    private property <string> pending-delete-finding: "";
    // Captured when the dialog opens, so the wording cannot drift from what will actually go if the
    // selection changes behind the dialog.
    private property <int> pending-delete-count: 1;
    // Whether the card that was right-clicked is part of the selection. The filmstrip's own rule:
    // right-click ON the selection acts on all of it, right-click outside acts on one.
    private property <bool> menu-target-selected: false;

    // THE CONTEXT MENU - `FR-37`.
    //
    // One menu, two subjects: an annotation on the canvas, or a Finding in the filmstrip. Which one
    // is open decides which entries are built, and both are built HERE rather than in Rust so the
    // list can react to what is selected without a round trip.
    //
    // `FR-37` forbids an entry with no other route, and every entry below honours it: the four
    // ordering actions are also buttons in the Properties tab, Delete is the key and the panel
    // button, and the filmstrip's entries are all things a click already does.
    private property <string> menu-subject: "";
    private property <string> menu-target: "";
    private property <length> menu-x;
    private property <length> menu-y;

    private property <[MenuEntry]> annotation-menu: [
        { action: "front", label: "Bring to front", hint: "", separator: false, enabled: true },
        { action: "forward", label: "Bring forward", hint: "", separator: false, enabled: true },
        { action: "backward", label: "Send backward", hint: "", separator: false, enabled: true },
        { action: "back", label: "Send to back", hint: "", separator: false, enabled: true },
        { action: "", label: "", hint: "", separator: true, enabled: false },
        { action: "delete", label: "Delete element", hint: "Del", separator: false, enabled: true },
    ];

    // The archived Tauri build's own filmstrip menu, entry for entry: Assemble, Copy Image, Open
    // File Location, Delete. "Open on canvas" and "Add to selection" are gone - the owner called
    // them useless and was right, they are a plain click and a Ctrl+click.
    private property <[MenuEntry]> finding-menu: [
        { action: "assemble", label: "Assemble selected...", hint: "", separator: false, enabled: root.selected-finding-count > 0 },
        { action: "copy", label: "Copy image", hint: "", separator: false, enabled: true },
        { action: "reveal", label: "Open file location", hint: "", separator: false, enabled: true },
        { action: "", label: "", hint: "", separator: true, enabled: false },
        { action: "delete-finding",
          label: root.menu-target-selected && root.selected-finding-count > 1
            ? "Delete " + root.selected-finding-count + " Findings..."
            : "Delete Finding...",
          hint: "", separator: false, enabled: true },
    ];

    // A Marker's own menu, which the archived build also had. One entry, because one is all a Marker
    // has that is not already a drag.
    private property <[MenuEntry]> marker-menu: [
        { action: "delete-marker", label: "Delete Marker", hint: "", separator: false, enabled: true },
    ];

    // Bare canvas: the actions that belong to the Finding as a whole rather than to anything under
    // the pointer.
    private property <[MenuEntry]> canvas-menu: [
        { action: "undo", label: "Undo", hint: "", separator: false, enabled: true },
        { action: "redo", label: "Redo", hint: "", separator: false, enabled: true },
        { action: "", label: "", hint: "", separator: true, enabled: false },
        { action: "copy", label: "Copy image", hint: "", separator: false, enabled: root.active-finding-id != "" },
        { action: "reveal", label: "Open file location", hint: "", separator: false, enabled: root.active-finding-id != "" },
    ];

    function open-menu(subject: string, target: string, x: length, y: length) {
        root.menu-subject = subject;
        root.menu-target = target;
        root.menu-x = x;
        root.menu-y = y;
    }
    // `FR-33`: "Redo/Undo history is supported for canvas additions, moves, edits, and deletions."
    callback annotation-undo();
    callback annotation-redo();
    callback bundle-preview-confirmed();
    callback bundle-preview-cancelled();
    // kind, finding-id, marker-id, text. One callback rather than four, because the document is one
    // sequence of blocks and which store a block writes to is Rust's business, not the layout's.
    callback bundle-block-edited(string, string, string, string);
    callback drag-window-requested();
    callback drag-window-moved();
    callback theme-toggle-clicked();
    callback bundles-drawer-clicked();
    callback settings-clicked();

    // THE SETTINGS SCREEN - `FR-18`, `FR-16`, `FR-17`, `DEC-004`.
    //
    // `settings-clicked` was a `println!` for the whole life of the Slint Editor (`BUG-57`), and the
    // Quality Budget's compression lever had nowhere to land because of it (`BUG-63`). Everything
    // below is filled by Rust from stores and registrars that already existed.
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <bool> run-at-startup: false;
    in-out property <string> startup-problem: "";
    in-out property <bool> open-editor-after-capture: false;
    in-out property <string> vault-path: "";
    in-out property <string> budget-name: "auto";
    in-out property <int> budget-max-long-edge: 1600;
    in-out property <int> budget-encoder-quality: 82;
    in-out property <int> budget-resize-percent: 100;
    in-out property <string> budget-readout: "";
    in-out property <string> budget-explainer: "";
    in-out property <[HotkeyRow]> hotkeys: [];
    in-out property <string> app-version: "";
    in-out property <string> bridge-status: "";
    // Which hotkey row is listening for a keypress, by action id. Owned by the window rather
    // than by the Settings component because RUST closes it - on a successful bind, and on the
    // shortcut actually arriving.
    in-out property <string> hotkey-listening: "";
    // The action whose shortcut most recently FIRED. This is the "preview listener" - press the
    // chord and the row confirms it reached Snapdown, which is the only way to know a global
    // hotkey works without leaving the screen that set it.
    in-out property <string> hotkey-last-fired: "";
    // The same event, worded for the Reviewer - "Ctrl+Alt+S (Trigger a Capture) reached Snapdown
    // just now." Separate from `hotkey-last-fired` above: that one is an action ID, compared against
    // a specific row; this one is a full sentence, shown once, centrally, in the Key Check panel -
    // moved there from a per-row line at the owner's request, since "does this reach Snapdown" is one
    // fact about the whole tab, not a per-row one. Clears on the same timer as `hotkey-last-fired`.
    in-out property <string> hotkey-last-fired-text: "";
    // Feedback for the Hotkeys tab's own sticky bottom panel - a validation error, a conflict, or
    // a bind confirmation. Set by Rust instead of the global toast for anything hotkey-related,
    // so it renders in the Settings screen the Reviewer is looking at, not the Editor behind it.
    in-out property <string> hotkey-feedback: "";
    in-out property <bool> hotkey-feedback-is-error: true;
    in-out property <string> hotkey-meta-key-label: "Win";
    // A live readout of the chord being composed, for the Key Check panel. RUST composes this too -
    // `format_chord_preview` in `main.rs` - so a raw control character (Enter, an arrow key with no
    // modifier) never lands here as unreadable tofu the way it could from a naive Slint-side echo of
    // `event.text`. Two-way: Slint clears it when a new row starts listening or Escape cancels one;
    // Rust sets it on every key event otherwise, and deliberately leaves it alone on a SUCCESSFUL
    // bind, so the Key Check panel keeps showing what was just proven to work.
    in-out property <string> hotkey-chord-preview: "";

    callback settings-closed();
    callback startup-toggled(bool);
    callback open-editor-after-capture-toggled(bool);
    callback vault-browse-clicked();
    callback vault-reveal-clicked();
    callback budget-chosen(string);
    callback budget-advanced(int, int, int);
    callback hotkey-key-pressed(string, bool, bool, bool, bool, string);
    callback hotkey-enabled-toggled(string, bool);
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg-app;
        border-width: 1px;
        border-color: root.border-strong;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            titlebar := Rectangle {
                height: 32px;
                background: root.bg-app;

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: root.border-subtle;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    // A press asks to drag. A maximized window cannot be moved, so Rust ignores this
                    // one and waits for actual movement - otherwise a single click on a maximized
                    // titlebar restores the window, which is what the owner saw: "klik title bar 1x
                    // malah mentrigger seolah2 doble klik".
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.drag-window-requested();
                        }
                    }
                    // MOVEMENT is what says a drag was meant. This is where a maximized window is
                    // restored and then dragged, which is what every window manager does.
                    moved => {
                        if (self.pressed) {
                            root.drag-window-moved();
                        }
                    }
                    double-clicked => {
                        root.maximize-clicked();
                    }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: 0px;
                    height: parent.height;
                    text: root.current-filename;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.text-muted;
                    font-family: "IBM Plex Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    padding-left: 0px;
                    padding-right: 0px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        Rectangle {
                            width: 32px;
                            height: 32px;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                image-fit: contain;
                                source: @image-url("../assets/app-icon.png");
                            }
                        }

                        Text {
                            text: "Snapdown Editor";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.text-secondary;
                            vertical-alignment: center;
                            font-family: "IBM Plex Sans";
                        }
                    }

                    HorizontalLayout {
                        spacing: 0px;
                        alignment: end;

                        Rectangle {
                            width: 32px; height: 32px;
                            background: theme-touch.has-hover ? root.bg-hover : transparent;

                            Image {
                                width: 15px; height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                                source: root.is-dark-theme ? @image-url("../assets/icons/sun.svg") : @image-url("../assets/icons/moon.svg");
                            }

                            theme-touch := TouchArea {
                                clicked => {
                                    root.is-dark-theme = !root.is-dark-theme;
                                    root.theme-toggle-clicked();
                                }
                            }
                        }

                        Rectangle {
                            width: 32px; height: 32px;
                            background: settings-touch.has-hover ? root.bg-hover : transparent;

                            Image {
                                width: 15px; height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                                source: @image-url("../assets/icons/settings.svg");
                            }

                            settings-touch := TouchArea { clicked => { root.settings-clicked(); } }
                        }

                        Rectangle { width: 1px; height: 16px; background: root.border-strong; y: 8px; }

                        Rectangle {
                            width: 46px; height: 32px; background: min-touch.has-hover ? root.bg-hover : transparent;

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 1px;
                                background: root.text-secondary;
                            }
                            min-touch := TouchArea { clicked => { root.minimize-clicked(); } }
                        }

                        Rectangle {
                            width: 46px; height: 32px; background: max-touch.has-hover ? root.bg-hover : transparent;

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                border-width: 1px;
                                border-color: root.text-secondary;
                                background: transparent;
                            }
                            max-touch := TouchArea { clicked => { root.maximize-clicked(); } }
                        }

                        Rectangle {
                            width: 46px; height: 32px; background: close-touch.has-hover ? Theme.chrome-close-hover : transparent;

                            Path {
                                width: 10px;
                                height: 10px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                stroke-width: 1.2px;
                                stroke: close-touch.has-hover ? Theme.text-on-plate : root.text-secondary;
                                MoveTo { x: 0; y: 0; }
                                LineTo { x: 10; y: 10; }
                                MoveTo { x: 10; y: 0; }
                                LineTo { x: 0; y: 10; }
                            }
                            close-touch := TouchArea { clicked => { root.close-clicked(); } }
                        }
                    }
                }
            }
            // TOOLBAR & RIBBON ACTION STRIP
            Rectangle {
                height: 52px;
                background: root.bg-app;

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: root.border-subtle;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 8px;
                    alignment: space-between;

                    // Group 1 (Left): Library / History & Input Actions
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;

                        IconButton {
                            width: 52px;
                            height: 44px;
                            icon: @image-url("../assets/icons/library.svg");
                            text: "Library";
                            clicked => { root.library-clicked(); }
                        }

                        Rectangle { width: 1px; height: 24px; background: root.border-strong; y: 10px; }

                        IconButton {
                            width: 54px;
                            height: 44px;
                            icon: @image-url("../assets/icons/camera.svg");
                            text: "Capture";
                            custom-text-color: Theme.accent-capture;
                            clicked => { root.capture-clicked(); }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: @image-url("../assets/icons/folder.svg");
                            text: "Open";
                            clicked => { root.open-file-clicked(); }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: @image-url("../assets/icons/clipboard.svg");
                            text: "Paste";
                            clicked => { root.paste-clicked(); }
                        }
                    }

                    // Group 2 (Center): Snug Annotation Palette Strip
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 0 ? @image-url("../assets/icons/marker-active.svg") : @image-url("../assets/icons/marker-inactive.svg");
                            text: "Marker";
                            active: root.active-tool-index == 0;
                            clicked => { root.active-tool-index = 0; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 1 ? @image-url("../assets/icons/square-active.svg") : @image-url("../assets/icons/square.svg");
                            text: "Shape";
                            active: root.active-tool-index == 1;
                            clicked => { root.active-tool-index = 1; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 2 ? @image-url("../assets/icons/message-square-active.svg") : @image-url("../assets/icons/message-square.svg");
                            text: "Callout";
                            active: root.active-tool-index == 2;
                            clicked => { root.active-tool-index = 2; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 3 ? @image-url("../assets/icons/blur-active.svg") : @image-url("../assets/icons/blur.svg");
                            text: "Blur";
                            active: root.active-tool-index == 3;
                            clicked => { root.active-tool-index = 3; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 4 ? @image-url("../assets/icons/arrow-up-right-active.svg") : @image-url("../assets/icons/arrow-up-right.svg");
                            text: "Arrow";
                            active: root.active-tool-index == 4;
                            clicked => { root.active-tool-index = 4; }
                        }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 5 ? @image-url("../assets/icons/type-active.svg") : @image-url("../assets/icons/type.svg");
                            text: "Text";
                            active: root.active-tool-index == 5;
                            clicked => { root.active-tool-index = 5; }
                        }

                        Rectangle { width: 1px; height: 24px; background: Theme.border-strong; y: 10px; }

                        IconButton {
                            width: 48px;
                            height: 44px;
                            icon: root.active-tool-index == 6 ? @image-url("../assets/icons/crop-active.svg") : @image-url("../assets/icons/crop.svg");
                            text: "Crop";
                            active: root.active-tool-index == 6;
                            clicked => { root.active-tool-index = 6; }
                        }

                        Rectangle { width: 1px; height: 24px; background: Theme.border-strong; y: 10px; }

                        IconButton {
                            width: 40px;
                            height: 44px;
                            icon: @image-url("../assets/icons/undo.svg");
                            text: "Undo";
                            clicked => { root.annotation-undo(); }
                        }
                        IconButton {
                            width: 40px;
                            height: 44px;
                            icon: @image-url("../assets/icons/redo.svg");
                            text: "Redo";
                            clicked => { root.annotation-redo(); }
                        }
                    }

                    // Group 3 (Right): Canvas Action.
                    //
                    // Ticket 19 (`.scratch/bundle-library/issues/19-...`): Share had no Rust handler
                    // at all, and Assemble acted on the filmstrip's ticked selection rather than the
                    // canvas beside it - the filmstrip footer and the finding context menu already
                    // carry Assemble, so it lost nothing by leaving the ribbon. Copy is the one
                    // ribbon action that is actually about the canvas: it copies the burned image of
                    // the open Finding.
                    // Sized on its own now rather than at the 52px that used to sit beside a wider
                    // Assemble - a single narrow button in the spot three used to fill read as a gap,
                    // not a choice.
                    HorizontalLayout {
                        alignment: end;

                        Rectangle {
                            width: 84px;
                            height: 44px;
                            border-radius: Theme.radius-sharp;
                            background: cp-touch.pressed ? Theme.accent-pressed : (cp-touch.has-hover ? Theme.accent-hover : Theme.accent-primary);
                            drop-shadow-blur: cp-touch.has-hover ? 6px : 2px;
                            drop-shadow-color: Theme.accent-primary.with-alpha(0.35);

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Image {
                                    width: 16px; height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    image-fit: contain;
                                    // Coloured like the label beside it - the pattern BUG-54's follow-up
                                    // fix established for every hand-rolled ribbon button.
                                    source: @image-url("../assets/icons/copy-white.svg");
                                    colorize: Theme.text-on-accent;
                                }
                                Text { text: "Copy Image"; font-size: 10px; font-weight: 700; color: Theme.text-on-accent; horizontal-alignment: center; font-family: "IBM Plex Sans"; }
                            }
                            cp-touch := TouchArea { clicked => { root.copy-image-clicked(); } }
                        }
                    }
                }
            }
            // MAIN WORKSPACE
            HorizontalLayout {
                spacing: 0px;

                VerticalLayout {
                    horizontal-stretch: 1;

                    // Central Image Viewport Canvas
                    Rectangle {
                        vertical-stretch: 1;
                        background: root.bg-card;

                        // `FR-33`: "Pressing Escape deselects the active element", and `FR-30`:
                        // "Deleting via Delete/Backspace keyboard keys ... removes the element".
                        //
                        // A FocusScope rather than a window-wide key handler, because the Editor is
                        // full of text fields and Backspace has an older job in every one of them.
                        // This takes focus only when an annotation is picked up, and any click into
                        // a note hands it straight back.
                        canvas-keys := FocusScope {
                            width: 100%;
                            height: 100%;

                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.annotation-selected("");
                                    return EventResult.accept;
                                }
                                // DELETE ONLY. Backspace used to do this too, straight from
                                // `FR-30`'s wording, and the owner asked for it back: *"Tombol
                                // backspace jangan mendelete element"*. The reason is the Callout -
                                // its words are typed ON the canvas now, so Backspace inside a
                                // Callout is a person deleting a letter, and one stray keystroke
                                // outside the caret would take the whole annotation instead.
                                if (event.text == Key.Delete && root.selected-annotation-id != "") {
                                    root.annotation-deleted(root.selected-annotation-id);
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }

                        scroll-view := ScrollView {
                            width: 100%;
                            height: 100%;
                            vertical-scrollbar-policy: always-off;
                            horizontal-scrollbar-policy: always-off;
                            viewport-width: max(self.visible-width, canvas-viewport.width + 48px);
                            viewport-height: max(self.visible-height, canvas-viewport.height + 48px);

                            canvas-viewport := Rectangle {
                                x: max(24px, (parent.width - self.width) / 2);
                                y: max(24px, (parent.height - self.height) / 2);
                                width: root.active-image.width * 1px;
                                height: root.active-image.height * 1px;
                                background: Theme.canvas-ground;
                                border-radius: Theme.radius-sharp;
                                drop-shadow-blur: 20px;
                                drop-shadow-color: Theme.shadow-soft;
                                visible: root.active-image.width > 0;

                                main-img := Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.active-image;
                                }

                                // Corner Brackets Viewfinder Overlay
                                CornerBrackets {
                                    size: 16px;
                                    stroke: 1.5px;
                                    color: Theme.border-strong;
                                    inset: 4px;
                                }

                                // The drag, drawn as the thing it will become. Declared BEFORE
                                // `canvas-surface`, so its own TouchAreas sit underneath and can
                                // never steal the gesture that is producing it.
                                if root.drawing && root.drag-is-real : AnnotationItem {
                                    width: 100%;
                                    height: 100%;
                                    ann: root.draw-preview;
                                    selected: false;
                                    blurred-source: root.blurred-capture;
                                }

                                // THE DRAWING SURFACE.
                                //
                                // Declared BELOW the annotation layer on purpose. Slint hit-tests in
                                // reverse declaration order, so a press that lands on an existing
                                // annotation is taken by that annotation - select and move - and a
                                // press on bare canvas falls through to here, where the active tool
                                // decides what to make. That is the behaviour of every annotation
                                // tool the Reviewer already knows, and it needs no seventh "select"
                                // button on a toolbar that is already seven wide.
                                //
                                // The consequence, stated rather than hidden: a new shape cannot be
                                // STARTED on top of an existing one. Start it beside and drag over.
                                canvas-surface := TouchArea {
                                    mouse-cursor: root.active-tool-index == 6
                                        ? MouseCursor.default
                                        : MouseCursor.crosshair;

                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down
                                            && ev.button == PointerEventButton.right) {
                                            root.open-menu("canvas", "",
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                            return;
                                        }
                                        if (ev.kind == PointerEventKind.down) {
                                            // A press on bare canvas is also how a selection is
                                            // dropped. `FR-33` gives Escape the same job; this is
                                            // the one the hand reaches for first.
                                            root.annotation-selected("");
                                            if (root.active-tool-index >= 1 && root.active-tool-index <= 5) {
                                                root.draw-x1 = self.mouse-x / parent.width;
                                                root.draw-y1 = self.mouse-y / parent.height;
                                                root.draw-x2 = root.draw-x1;
                                                root.draw-y2 = root.draw-y1;
                                                root.drawing = true;
                                            }
                                        }
                                        if (ev.kind == PointerEventKind.up && root.drawing) {
                                            root.drawing = false;
                                            root.commit-drawing();
                                        }
                                    }
                                    moved => {
                                        if (root.drawing) {
                                            root.draw-x2 = Math.max(0.0, Math.min(1.0, self.mouse-x / parent.width));
                                            root.draw-y2 = Math.max(0.0, Math.min(1.0, self.mouse-y / parent.height));
                                        }
                                    }
                                    clicked => {
                                        if (root.active-tool-index == 0) {
                                            root.marker-placed(self.mouse-x / parent.width, self.mouse-y / parent.height);
                                        }
                                    }
                                }

                                // The annotations themselves. Above the surface so they can be
                                // picked up, below the Markers so a reticle is never buried.
                                for a in root.annotations : AnnotationItem {
                                    width: 100%;
                                    height: 100%;
                                    ann: a;
                                    selected: a.id == root.selected-annotation-id;
                                    blurred-source: root.blurred-capture;
                                    // Only the selected one previews, and only while the slider is
                                    // actually being dragged.
                                    size-override: a.id == root.selected-annotation-id
                                        ? root.live-font-size : 0;
                                    menu-requested(x, y) => {
                                        root.annotation-selected(a.id);
                                        root.open-menu("annotation", a.id, x, y);
                                    }
                                    select-requested => {
                                        root.annotation-selected(a.id);
                                        // Picking up a Text or a Callout opens the tab that can
                                        // change it. Without this the controls exist behind a tab
                                        // nobody has a reason to click, which is how the panel
                                        // ended up floating over the canvas in the first place.
                                        if (a.kind == "text" || a.kind == "callout") {
                                            root.active-tab-index = 1;
                                        }
                                        // Picking one up is what hands the canvas the keyboard.
                                        // Without this Escape and Delete would go to whatever was
                                        // focused before - most often a note field, where Delete
                                        // has an older and much worse meaning.
                                        canvas-keys.focus();
                                    }
                                    text-edited(body) => { root.annotation-text-edited(a.id, body); }
                                    geometry-changed(x1, y1, x2, y2) => {
                                        root.annotation-geometry-changed(a.id, x1, y1, x2, y2);
                                    }
                                    tail-changed(tx, ty) => { root.annotation-tail-moved(a.id, tx, ty); }
                                }

                                // Numbered Reticle Marker Overlay, now draggable.
                                //
                                // A Marker could be placed and never moved, which made a mis-click
                                // permanent: the only remedy was delete and re-place, and deleting
                                // renumbers everything after it, so correcting Marker 2's position
                                // rewrote Marker 2's line number. The owner asked for the obvious
                                // fix: *"marker maunya bisa digeser2 meskipun sudah ditaruh"*.
                                //
                                // Grip on the live position, grab area on the committed one - the
                                // same rule `AnnotationItem` documents, and for the same reason.
                                for m in root.markers : Rectangle {
                                    x: 0; y: 0;
                                    width: 100%;
                                    height: 100%;
                                    background: transparent;

                                    private property <bool> dragging: false;
                                    private property <float> dx;
                                    private property <float> dy;
                                    private property <float> lx: self.dragging ? self.dx : m.x;
                                    private property <float> ly: self.dragging ? self.dy : m.y;

                                    ReticleMarker {
                                        x: parent.lx * parent.width - 15px;
                                        y: parent.ly * parent.height - 15px;
                                        ordinal: m.ordinal;
                                    }

                                    TouchArea {
                                        x: m.x * parent.width - 15px;
                                        y: m.y * parent.height - 15px;
                                        width: 30px;
                                        height: 30px;
                                        mouse-cursor: MouseCursor.move;
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                                root.open-menu("marker", m.id,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                                return;
                                            }
                                            if (ev.kind == PointerEventKind.down) {
                                                parent.dx = m.x;
                                                parent.dy = m.y;
                                                parent.dragging = true;
                                            }
                                            if (ev.kind == PointerEventKind.up && parent.dragging) {
                                                parent.dragging = false;
                                                root.marker-moved(m.id, parent.dx, parent.dy);
                                            }
                                        }
                                        moved => {
                                            if (self.pressed) {
                                                parent.dx = Math.max(0.0, Math.min(1.0,
                                                    m.x + (self.mouse-x - self.pressed-x) / parent.width));
                                                parent.dy = Math.max(0.0, Math.min(1.0,
                                                    m.y + (self.mouse-y - self.pressed-y) / parent.height));
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Custom high-contrast scrollbar overlay
                        // (the native fluent-style scrollbar is a 2px hairline that is
                        // effectively invisible against the dark canvas until hovered)
                        if scroll-view.viewport-height > scroll-view.visible-height : SdScrollBar {
                            vertical: true;
                            viewport-extent: scroll-view.viewport-height;
                            visible-extent: scroll-view.visible-height;
                            offset: -scroll-view.viewport-y;
                            scrolled(position) => { scroll-view.viewport-y = -position; }
                            x: parent.width - self.width - 3px;
                            y: 4px;
                            height: parent.height - 8px - (scroll-view.viewport-width > scroll-view.visible-width ? 12px : 0px);
                        }

                        if scroll-view.viewport-width > scroll-view.visible-width : SdScrollBar {
                            vertical: false;
                            viewport-extent: scroll-view.viewport-width;
                            visible-extent: scroll-view.visible-width;
                            offset: -scroll-view.viewport-x;
                            scrolled(position) => { scroll-view.viewport-x = -position; }
                            x: 4px;
                            y: parent.height - self.height - 3px;
                            width: parent.width - 8px - (scroll-view.viewport-height > scroll-view.visible-height ? 12px : 0px);
                        }

                        } // canvas-keys
                    }

                    // Readout Status Strip
                    Rectangle {
                        height: 28px;
                        background: root.bg-subtle;

                        Rectangle { y: 0px; width: 100%; height: 1px; background: root.border-subtle; }
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: root.border-subtle; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;
                            SdIconLabel {
                                icon: @image-url("../assets/icons/ruler.svg");
                                text: root.resolution-text;
                                text-color: root.text-muted;
                                mono: true;
                            }
                            Text { text: "·"; font-size: 11px; color: root.border-strong; vertical-alignment: center; }
                            SdIconLabel {
                                icon: @image-url("../assets/icons/hard-drive.svg");
                                text: root.size-text;
                                text-color: root.text-muted;
                                mono: true;
                            }
                        }
                    }

                    // BOTTOM FILMSTRIP TRAY
                    //
                    // The strip scrolls horizontally, and that is not a nicety. Its cards are a fixed
                    // 120px, so a bare `HorizontalLayout` reports a minimum width of roughly 132px
                    // per Finding, and that minimum propagates up through the workspace layout - after
                    // a dozen captures the left column demanded more width than the window had and
                    // squeezed the 440px inspector to nothing. It read as "the canvas keeps growing";
                    // what was growing was this strip's appetite. A ScrollView has no appetite.
                    //
                    // The Assemble tile is declared OUTSIDE the ScrollView and the strip is inset to
                    // the right of it, so the tile is sticky: it used to be the first child of the
                    // scrolling row and slid off the left edge as soon as there were a few Findings.
                    Rectangle {
                        // 110px of cards plus room for the bar underneath them.
                        height: 124px;
                        background: root.bg-app;

                        // 12px margin + the 110px tile + 12px gap.
                        Rectangle {
                            x: 134px;
                            width: parent.width - 134px;
                            height: 100%;

                            filmstrip-scroll := ScrollView {
                                width: 100%;
                                height: 100%;
                                vertical-scrollbar-policy: always-off;
                                // Both native bars off, and a bar of our own below - the same
                                // arrangement the canvas uses, so the two read as one product. The
                                // native fluent bar is a 2px hairline that is invisible until hovered.
                                horizontal-scrollbar-policy: always-off;
                                viewport-width: max(self.visible-width, root.filmstrip-items.length * 132px + 12px);
                                viewport-height: self.visible-height;

                                HorizontalLayout {
                                    width: filmstrip-scroll.viewport-width;
                                    height: 110px;
                                    padding-top: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: start;

                                    for thumb in root.filmstrip-items : Rectangle {
                                        width: 120px;
                                        height: 86px;
                                        background: root.bg-subtle;
                                        border-radius: Theme.radius-sharp;
                                        // Selection reads the way a file manager's does: an accent
                                        // outline plus a wash over the thumbnail. The checkbox that
                                        // used to sit in the corner is gone - it was a second
                                        // vocabulary for the same idea, and nothing else in this
                                        // product asks to be ticked.
                                        border-width: thumb.is-selected || thumb.is-active ? 2px : 1px;
                                        border-color: thumb.is-selected || thumb.is-active
                                            ? Theme.accent-primary
                                            : root.border-strong;
                                        clip: true;

                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                            source: thumb.image;
                                        }

                                        if thumb.is-selected : Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            background: Theme.accent-surface;
                                        }

                                        Rectangle {
                                            y: parent.height - 18px;
                                            width: 100%;
                                            height: 18px;
                                            background: root.bg-card;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: space-between;
                                                Text { text: thumb.time-str; font-size: 9px; font-family: "IBM Plex Mono"; color: root.text-secondary; vertical-alignment: center; }
                                                Text { text: thumb.dimensions-str; font-size: 9px; font-family: "IBM Plex Mono"; color: root.text-muted; vertical-alignment: center; }
                                            }
                                        }

                                        // WHICH ONE IS ON THE CANVAS.
                                        //
                                        // Was a pill reading "● Editing", which cost 70px of a 120px
                                        // card and covered the thing it was describing. This is the
                                        // accent bar the tab header already uses for the same idea -
                                        // `theme.slint` names `accent-primary` "Primary Actions
                                        // (Assemble, Tab Active Bar)" - so it needs no words.
                                        if thumb.is-active : Rectangle {
                                            y: 0px;
                                            width: 100%;
                                            height: 4px;
                                            background: Theme.accent-primary;
                                        }

                                        TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            // `pointer-event` rather than `clicked`, because
                                            // `clicked` carries no modifiers and Ctrl and Shift are
                                            // the whole point: one click means open, Ctrl+click means
                                            // add or remove, Shift+click means through to here.
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down
                                                    && event.button == PointerEventButton.left) {
                                                    root.finding-clicked(
                                                        thumb.id,
                                                        event.modifiers.control,
                                                        event.modifiers.shift);
                                                }
                                                // Right-click raises the Finding's own menu.
                                                // `FR-37`: every entry on it is something a click
                                                // already does, so the menu is a shortcut and never
                                                // the only route to anything.
                                                if (event.kind == PointerEventKind.down
                                                    && event.button == PointerEventButton.right) {
                                                    root.menu-target-selected = thumb.is-selected;
                                                    root.open-menu("finding", thumb.id,
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // The same bar as the canvas: 8px, `border-strong`, 4px radius, minimum
                            // 28px, and only present while there is something to scroll.
                            //
                            // Draggable, unlike the canvas's, because it has to be: a vertical wheel
                            // does not scroll a horizontal-only view, so with no native bar and no
                            // handle there would be no way to reach the later Findings at all.
                            if filmstrip-scroll.viewport-width > filmstrip-scroll.visible-width : SdScrollBar {
                                vertical: false;
                                viewport-extent: filmstrip-scroll.viewport-width;
                                visible-extent: filmstrip-scroll.visible-width;
                                offset: -filmstrip-scroll.viewport-x;
                                scrolled(position) => { filmstrip-scroll.viewport-x = -position; }
                                x: 0px;
                                y: parent.height - self.height - 3px;
                                width: parent.width - 12px;
                            }
                        }

                        // STICKY: the Assemble tile. Declared after the strip so it draws over it,
                        // and outside the ScrollView so it does not move.
                        //
                        // REBUILT to the G3 design, which the owner read as untidy in the shipped
                        // version and was right to. `01-studio-workspace.html` puts the count as a
                        // small COLOURED STATUS line above a button - 0.65rem, weight 800. What
                        // shipped was an 11px `text-primary` line at the same weight as the button's
                        // own label, so two things of different kinds looked like two halves of one
                        // thing, badly spaced.
                        //
                        // The button is `SdActionButton` now rather than a hand-drawn Rectangle with
                        // its own hover and disabled logic - which is what `design-system-guide.md`
                        // means by "Two places showing the same kind of thing MUST reference the same
                        // component, not the same numbers".
                        Rectangle {
                            x: 12px;
                            y: 12px;
                            width: 110px;
                            height: 86px;
                            background: root.bg-card;
                            border-radius: Theme.radius-sharp;
                            border-width: 1px;
                            border-color: root.selected-finding-count > 0
                                ? Theme.accent-primary : root.border-strong;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    text: root.selected-finding-count == 0
                                        ? "Nothing picked"
                                        : root.selected-finding-count + (root.selected-finding-count == 1 ? " Finding" : " Findings");
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: root.selected-finding-count > 0
                                        ? Theme.accent-primary : root.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    font-family: "IBM Plex Sans";
                                }

                                SdActionButton {
                                    label: "Assemble";
                                    icon: @image-url("../assets/icons/package.svg");
                                    height: 30px;
                                    enabled: root.selected-finding-count > 0;
                                    clicked => { root.assemble-bundle-clicked(); }
                                }
                            }
                        }
                    }
                }
                // RIGHT PANEL: 440px INSPECTOR
                Rectangle {
                    width: 440px;
                    background: root.bg-app;

                    Rectangle { x: 0px; width: 1px; height: 100%; background: root.border-subtle; }

                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        // OBSERVATION SUMMARY - above the tabs, always on screen.
                        //
                        // It used to sit inside `if active-tab-index == 0`, and that one placement
                        // caused two different failures.
                        //
                        // The visible one: the owner could not tell whether a Note had been saved,
                        // because the only place it ever appeared was behind a tab and gave no sign
                        // of itself from outside. A Finding's note is its primary content, not a
                        // tab's detail.
                        //
                        // The structural one: an `if` subtree is CREATED and DESTROYED rather than
                        // shown and hidden, and NEITHER binding form survives that. `text <=>` links
                        // the widget's property and this one into a single property at construction,
                        // and the rebuild re-ran that link against the widget's own empty string. A
                        // one-way `text:` binding avoids that and trades it for a worse fault: Slint
                        // drops a binding the moment anything writes to the property, and the widget
                        // writes to itself on every keystroke - so after the first edit no newly
                        // selected Finding's note ever lands again.
                        //
                        // Out of the conditional, the link happens once at window construction and
                        // `<=>` is simply correct in both directions (`BUG-45`).
                        Rectangle {
                            height: 172px;
                            background: root.bg-app;

                            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: root.border-subtle; }

                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;

                                // The component now carries these values, and the capture panel
                                // reads the same ones - which is the only thing that keeps the two
                                // equal as either changes.
                                SdSectionLabel {
                                    text: "NOTES";
                                }
                                // The same component the capture note uses.
                                //
                                // It was a `std-widgets` `TextEdit`, and that produced two defects
                                // at once. It paints from Slint's own palette rather than this
                                // product's, so on a white panel it rendered white-on-white and was
                                // legible only while focused - and then went grey, which is a third
                                // text-entry appearance in one product. And, being an imported
                                // COMPONENT rather than a built-in element, it took its own
                                // preferred size instead of filling its parent: the accessibility
                                // tree showed it holding the right note with an INFINITE bounding
                                // rectangle. Two rounds of binding fixes could not have touched
                                // either cause.
                                SdTextField {
                                    height: 120px;
                                    placeholder: "No note on this Finding.";
                                    text <=> root.finding-note;
                                    edited => {
                                        // Written through on every edit. A Finding's note used to be
                                        // held only in this property, so selecting another Finding
                                        // overwrote it and the edit was gone - silent data loss, and
                                        // the sort a Reviewer only discovers later.
                                        root.finding-note-edited(root.finding-note);
                                    }
                                }
                            }
                        }

                        // TAB HEADERS ([Notes] & [Properties])
                        Rectangle {
                            height: 46px;
                            background: root.bg-app;

                            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: root.border-subtle; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;

                                // Tab 0: Marker Notes
                                //
                                // Renamed, because the Observation Summary moved out of it and up
                                // above the tab bar - so what is left in here is only the per-marker
                                // commentary, and a tab called "Notes" beside a permanently visible
                                // note panel says nothing about which notes it holds.
                                Rectangle {
                                    width: 140px;
                                    Rectangle {
                                        y: parent.height - 2.5px;
                                        width: 100%;
                                        height: root.active-tab-index == 0 ? 2.5px : 0px;
                                        background: Theme.accent-primary;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Rectangle {
                                            width: 14px;
                                            height: parent.height;
                                            Image {
                                                y: (parent.height - self.height) / 2 + 1px;
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                // A marker pin, not a document. `file-text.svg`
                                                // described the Observation Summary, which is no
                                                // longer in this tab; the icon has to follow the
                                                // content or it reads as the wrong tab.
                                                //
                                                // Blue OUTLINE, matching `palette.svg` on the
                                                // Properties tab beside it - the two tab icons are a
                                                // pair and have to speak one language. `marker.svg`
                                                // is a filled red pin, which is correct for a marker
                                                // ON the canvas and wrong for a tab, so this is a
                                                // new file: the existing marker icons are untouched.
                                                source: @image-url("../assets/icons/marker-outline.svg");
                                            }
                                        }
                                        Text {
                                            text: "Marker Notes";
                                            font-size: 13px;
                                            font-weight: root.active-tab-index == 0 ? 700 : 500;
                                            color: root.active-tab-index == 0 ? Theme.accent-primary : root.text-muted;
                                            vertical-alignment: center;
                                            font-family: "IBM Plex Sans";
                                        }
                                    }
                                    TouchArea { clicked => { root.active-tab-index = 0; } }
                                }

                                // Tab 1: Properties
                                Rectangle {
                                    width: 120px;
                                    Rectangle {
                                        y: parent.height - 2.5px;
                                        width: 100%;
                                        height: root.active-tab-index == 1 ? 2.5px : 0px;
                                        background: Theme.accent-primary;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Rectangle {
                                            width: 14px;
                                            height: parent.height;
                                            Image {
                                                y: (parent.height - self.height) / 2 + 1px;
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/palette.svg");
                                            }
                                        }
                                        Text {
                                            text: "Properties";
                                            font-size: 13px;
                                            font-weight: root.active-tab-index == 1 ? 700 : 500;
                                            color: root.active-tab-index == 1 ? Theme.accent-primary : root.text-muted;
                                            vertical-alignment: center;
                                            font-family: "IBM Plex Sans";
                                        }
                                    }
                                    TouchArea { clicked => { root.active-tab-index = 1; } }
                                }
                            }
                        }

                        if root.active-tab-index == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            padding-left: 16px;
                            // The bar lives in this 4px gutter rather than on top of the cards. It
                            // was inside the 16px padding, so it overlapped them - a scrollbar drawn
                            // across the thing it is scrolling.
                            padding-right: 4px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;

                            SdSectionLabel {
                                text: "MARKER NOTES (" + root.markers.length + ")";
                            }

                            // The Marker list gets a BOUNDED area of its own, and `vertical-stretch`
                            // gives it whatever the label above and the card below do not take.
                            //
                            // Both tabs used to sit inside one ScrollView, which meant the cost card
                            // was the last thing in a scrolling column: with a few Markers it slid
                            // off the bottom of the panel and had to be scrolled back to. A running
                            // total that has to be hunted for is not a running total.
                            Rectangle {
                                vertical-stretch: 1;

                                marker-scroll := ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    vertical-scrollbar-policy: always-off;
                                    horizontal-scrollbar-policy: always-off;
                                    viewport-width: self.visible-width;

                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        // The cards keep the inset the panel's padding used to give
                                        // them; the bar gets the gutter to itself.
                                        padding-right: 12px;

                                        for marker in root.markers : Rectangle {
                                            border-radius: Theme.radius-sharp;
                                            background: root.bg-card;
                                            border-width: 1px;
                                            border-color: root.border-strong;

                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        ReticleMarker {
                                                            ordinal: marker.ordinal;
                                                        }
                                                        Text { text: "Marker #" + marker.ordinal; font-size: 12px; font-weight: 700; color: root.text-primary; vertical-alignment: center; font-family: "IBM Plex Sans"; }
                                                        Text { text: "(" + round(marker.x * 100) + "%, " + round(marker.y * 100) + "%)"; font-size: 10px; color: root.text-muted; vertical-alignment: center; font-family: "IBM Plex Mono"; }
                                                    }
                                                    // The delete affordance. It was a bare glyph with
                                                    // nothing behind it - it LOOKED like a button and
                                                    // removed nothing. The TouchArea is declared before
                                                    // the glyph because an id resolves backwards only,
                                                    // and a Text does not consume a click.
                                                    Rectangle {
                                                        width: 20px;
                                                        height: 20px;
                                                        border-radius: Theme.radius-sharp;
                                                        del-touch := TouchArea {
                                                            mouse-cursor: MouseCursor.pointer;
                                                            clicked => { root.delete-marker-clicked(marker.id); }
                                                        }
                                                        background: del-touch.has-hover ? root.bg-hover : transparent;
                                                        // A drawn icon, not a glyph. `✕` fell back to
                                                        // whatever the font had, sat off-centre, and
                                                        // said "close" rather than "delete".
                                                        Image {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 13px;
                                                            height: 13px;
                                                            image-fit: contain;
                                                            source: @image-url("../assets/icons/trash.svg");
                                                            colorize: del-touch.has-hover ? Theme.semantic-error : root.text-muted;
                                                        }
                                                    }
                                                }

                                                // The product's one text field, like every other one.
                                                // This was a `LineEdit` in a bare Rectangle - the same
                                                // two faults as the Observation Summary, unseen only
                                                // because this list has always been empty.
                                                // Grows with the note rather than clipping it,
                                                // exactly as the capture field does. A Marker's
                                                // note is prose, and a fixed 32px hid everything
                                                // past the first line.
                                                SdTextField {
                                                    pad: 8px;
                                                    text-size: 12px;
                                                    placeholder: "What is wrong here?";
                                                    text: marker.comment;
                                                    edited => { root.marker-comment-edited(marker.id, self.text); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // The canvas's bar, third time. Indicator only, like the canvas's
                                // own: a vertical wheel scrolls a vertical view natively, so there
                                // is nothing here for a handle to do that the wheel does not - the
                                // filmstrip's bar is draggable only because a vertical wheel cannot
                                // scroll a horizontal view.
                                if marker-scroll.viewport-height > marker-scroll.visible-height : SdScrollBar {
                                    vertical: true;
                                    viewport-extent: marker-scroll.viewport-height;
                                    visible-extent: marker-scroll.visible-height;
                                    offset: -marker-scroll.viewport-y;
                                    scrolled(position) => { marker-scroll.viewport-y = -position; }
                                    x: parent.width - self.width;
                                    y: 0px;
                                    height: parent.height;
                                }
                            }

                            // STICKY: the cost estimate. Outside the scrolling area, so it stays on
                            // screen however long the Marker list gets.
                            //
                            // And the numbers are REAL now. They were "~1.217 TK", "Image
                            // (1020x885) ~1204 tk", "Notes (46 chars) ~13 tk" - hard-coded, and
                            // pinning invented figures to the bottom of the panel where they are
                            // always in view is worse than letting them scroll away. The image
                            // figure uses w*h/750, which is where the 1204 came from in the first
                            // place; the text figures are characters/4, the rule of thumb every
                            // tokeniser lands near for English prose.
                            Rectangle {
                                height: 84px;
                                border-radius: Theme.radius-sharp;
                                background: root.bg-card;
                                border-width: 1px;
                                border-color: root.border-strong;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Image {
                                                width: 13px; height: 13px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/coins.svg");
                                            }
                                            Text { text: "ESTIMATED LLM COST"; font-size: 10px; font-weight: 800; color: root.text-secondary; font-family: "IBM Plex Sans"; }
                                        }
                                        Text {
                                            text: "~" + (root.image-token-estimate + round(root.finding-note.character-count / 4) + round(root.marker-char-count / 4)) + " tk";
                                            font-size: 12px;
                                            font-weight: 800;
                                            color: Theme.accent-primary;
                                            font-family: "IBM Plex Mono";
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Image {
                                                width: 12px; height: 12px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/image.svg");
                                            }
                                            Text { text: "Image (" + root.resolution-text + ")"; font-size: 11px; color: root.text-muted; font-family: "IBM Plex Sans"; }
                                        }
                                        Text { text: "~" + root.image-token-estimate + " tk"; font-size: 11px; color: root.text-muted; font-family: "IBM Plex Mono"; }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Image {
                                                width: 12px; height: 12px;
                                                image-fit: contain;
                                                source: @image-url("../assets/icons/file-lines.svg");
                                            }
                                            Text {
                                                text: "Notes (" + root.finding-note.character-count + " chars) + " + root.markers.length + " marker" + (root.markers.length == 1 ? "" : "s");
                                                font-size: 11px;
                                                color: root.text-muted;
                                                font-family: "IBM Plex Sans";
                                            }
                                        }
                                        Text {
                                            text: "~" + (round(root.finding-note.character-count / 4) + round(root.marker-char-count / 4)) + " tk";
                                            font-size: 11px;
                                            color: root.text-muted;
                                            font-family: "IBM Plex Mono";
                                        }
                                    }
                                }
                            }
                        }

                        // THE PROPERTIES TAB - `FR-32`.
                        //
                        // What was here was a placeholder: a "Font Family" field pre-filled with
                        // "IBM Plex Sans, sans-serif" that was bound to nothing, and a "Font Size:
                        // 14px" that was a `Text`, not a control. It looked like a working panel and
                        // was the same class of thing as `BUG-55` - built, mounted, joined to
                        // nothing.
                        //
                        // The real controls arrived on the canvas first, floating over the capture.
                        // The owner moved them twice: off the canvas, then into this tab, which is
                        // where a tab called Properties should have led all along.
                        //
                        // Text and Callout only - *"hanya muncul di element text dan callout"*. A
                        // Shape, an Arrow and a Blur carry no words, so the three controls would
                        // change nothing. The WORDS are not here either: they are typed on the shape
                        // itself, by double-click.
                        if root.active-tab-index == 1 : ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                alignment: start;

                                // One heading, and it says the same thing whatever is selected.
                                //
                                // It used to become "CALLOUT PROPERTIES" or "TEXT PROPERTIES", and
                                // there was a second copy of the same label inside the controls -
                                // so selecting a Callout produced the word twice and the panel's own
                                // title moved under the Reviewer. A panel is named for what it is,
                                // not for what is currently in it.
                                SdSectionLabel {
                                    text: "ELEMENT PROPERTIES";
                                }

                                // ORDER - for ANY selected annotation, not only the two that
                                // carry words.
                                //
                                // Also what keeps the context menu honest: `FR-37` forbids an entry
                                // with no other route, and the four ordering items are on that menu.
                                // Putting them here makes the menu a shortcut rather than the only
                                // way to reach them.
                                //
                                // The SCREENSHOT is not in this order and cannot be. It is not an
                                // annotation; it is the thing being annotated, and it is underneath
                                // all of them by construction.
                                if root.selected-annotation-id != "" : VerticalLayout {
                                    spacing: 6px;

                                    SdCaption { text: "Order"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        for step in [
                                            { action: "front", label: "Front" },
                                            { action: "forward", label: "Up" },
                                            { action: "backward", label: "Down" },
                                            { action: "back", label: "Back" },
                                        ] : Rectangle {
                                            horizontal-stretch: 1;
                                            height: 26px;
                                            border-radius: Theme.radius-sharp;
                                            background: order-touch.has-hover ? root.bg-hover : root.bg-subtle;
                                            order-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    root.annotation-reordered(
                                                        root.selected-annotation-id, step.action);
                                                }
                                            }
                                            Text {
                                                text: step.label;
                                                font-size: 11px;
                                                color: root.text-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                font-family: "IBM Plex Sans";
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: root.border-subtle; }
                                }

                                // An empty state that says what to do, rather than a dead form.
                                //
                                // Only when NOTHING is selected. With something selected there is
                                // always the Order block above, so a line saying "select something"
                                // underneath it would be describing a state the panel is not in.
                                if root.selected-annotation-id == "" : Text {
                                    text: "Right-click or select an element on the canvas. Size, font and alignment apply to Text and Callout.";
                                    font-size: 12px;
                                    color: root.text-muted;
                                    wrap: word-wrap;
                                    font-family: "IBM Plex Sans";
                                }

                                    if root.selected-has-words : VerticalLayout {
                                        spacing: 6px;

                                                SdCaption { text: "Size"; }
                                        // A slider AND a number, because they answer different
                                        // questions. The slider is for "a bit bigger than that",
                                        // which is how a size is actually chosen against a
                                        // screenshot; the field is for "18, the same as the last
                                        // one". The five-step ladder that was here could do neither.
                                        //
                                        // Both are in IMAGE pixels. The canvas draws a Finding at
                                        // natural size, so the number means the same thing here and
                                        // in the burned PNG.
                                        HorizontalLayout {
                                            spacing: 8px;

                                            SdSlider {
                                                horizontal-stretch: 1;
                                                y: 6px;
                                                minimum: 8;
                                                maximum: 72;
                                                value: root.selected-annotation-font-size;
                                                moved(size) => { root.live-font-size = size; }
                                                changed(size) => {
                                                    root.live-font-size = 0;
                                                    root.annotation-style-changed(
                                                        root.selected-annotation-id, size,
                                                        root.selected-annotation-font-family,
                                                        root.selected-annotation-align);
                                                }
                                            }

                                            size-field := SdTextField {
                                                width: 54px;
                                                pad: 6px;
                                                text-size: 12px;
                                                commit-on-enter: true;
                                                mono: true;
                                                // Live while the slider is being dragged
                                                // (`live-font-size`), the committed model value
                                                // otherwise - so a value the store refused reverts
                                                // here rather than sitting in the field looking
                                                // accepted.
                                                text: Math.round(root.live-font-size > 0
                                                    ? root.live-font-size : root.selected-annotation-font-size);
                                                accepted => {
                                                    // Clamped to the slider's own range: the field
                                                    // is a second way to set one value, not a second
                                                    // set of rules for it.
                                                    root.annotation-style-changed(
                                                        root.selected-annotation-id,
                                                        Math.max(8, Math.min(72, Math.round(self.text.to-float()))),
                                                        root.selected-annotation-font-family,
                                                        root.selected-annotation-align);
                                                }
                                            }
                                        }

                                        SdCaption { text: "Style"; }
                                        // Two families, and only two, because the BURN ships these
                                        // and nothing else. A system font picker here would let the
                                        // Reviewer choose something the burned PNG cannot render,
                                        // and the canvas would be the only place it ever appeared.
                                        SdSegmented {
                                            selected: root.selected-annotation-font-family;
                                            options: [
                                                { id: "IBM Plex Sans", label: "Sans" },
                                                { id: "IBM Plex Mono", label: "Mono" },
                                            ];
                                            chosen(family) => {
                                                root.annotation-style-changed(
                                                    root.selected-annotation-id,
                                                    root.selected-annotation-font-size, family,
                                                    root.selected-annotation-align);
                                            }
                                        }

                                        SdCaption { text: "Align"; }
                                        SdSegmented {
                                            selected: root.selected-annotation-align;
                                            options: [
                                                { id: "start", label: "Left" },
                                                { id: "center", label: "Center" },
                                                { id: "end", label: "Right" },
                                            ];
                                            chosen(align) => {
                                                root.annotation-style-changed(
                                                    root.selected-annotation-id,
                                                    root.selected-annotation-font-size,
                                                    root.selected-annotation-font-family, align);
                                            }
                                        }

                                        SdActionButton {
                                            label: "Delete element";
                                            primary: false;
                                            height: 28px;
                                            clicked => { root.annotation-deleted(root.selected-annotation-id); }
                                        }

                                        Rectangle { height: 1px; background: root.border-subtle; }
                                    }
                            }
                        }

                    }
                }
            }
        }
        // RESULT LINE - last declared, so it draws over everything.
        //
        // Assembling a Bundle writes image files, a Markdown file and a database row, and changes
        // nothing at all on screen. Without a line that says so, a success and a silent failure look
        // identical from the Editor - and a silent failure on exactly this path is what BUG-19 and
        // BUG-23 both are. The semantic colour is carried by the border and the dot rather than by
        // the text, because a red or green body on a tinted plate does not clear AA in both themes.
        if root.toast-text != "" : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 28px;
            width: min(560px, parent.width - 64px);
            height: 42px;
            border-radius: Theme.radius-sharp;
            background: root.bg-card;
            border-width: 1px;
            border-color: root.toast-is-error ? Theme.semantic-error : Theme.semantic-success;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.overlay-shadow;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: start;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-pill;
                    background: root.toast-is-error ? Theme.semantic-error : Theme.semantic-success;
                }

                Text {
                    text: root.toast-text;
                    font-size: 12px;
                    font-weight: 600;
                    color: root.text-primary;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    font-family: "IBM Plex Sans";
                }
            }
        }

        // The hotkey arrival clears itself for the same reason the result line does: a confirmation
        // that stays forever stops being a confirmation of anything in particular.
        Timer {
            interval: 4s;
            running: root.hotkey-last-fired != "";
            triggered => {
                root.hotkey-last-fired = "";
                root.hotkey-last-fired-text = "";
            }
        }

        // Clears itself. A result line that stays forever becomes furniture, and the next result is
        // then indistinguishable from the last one.
        Timer {
            interval: 7s;
            running: root.toast-text != "";
            triggered => { root.toast-text = ""; }
        }

        // THE LIBRARY - above the Editor, the same layer Assemble & Review and Settings sit at.
        if root.library-open : SdLibrary {
            state: root.library-state;
            error-message: root.library-error-message;
            rows: root.library-rows;

            menu-target: root.library-menu-target;
            menu-sealed: root.library-menu-sealed;
            menu-x: root.library-menu-x;
            menu-y: root.library-menu-y;
            pending-disassemble: root.library-pending-disassemble;
            pending-delete: root.library-pending-delete;
            pending-bundle-name: root.library-pending-bundle-name;
            pending-bundle-finding-count: root.library-pending-bundle-finding-count;
            pending-discard: root.library-pending-discard;
            pending-discard-warning: root.library-pending-discard-warning;
            pending-delete-both: root.library-pending-delete-both;

            closed => { root.library-closed(); }
            try-again-clicked => { root.library-try-again-clicked(); }
            open-file-location-clicked => { root.library-open-file-location-clicked(); }
            copy-markdown-clicked(id) => { root.library-copy-markdown-clicked(id); }
            bundle-open-file-location-clicked(id) => { root.library-bundle-open-file-location-clicked(id); }
            row-menu-requested(id, x, y) => { root.library-row-menu-requested(id, x, y); }
            row-menu-dismissed => { root.library-row-menu-dismissed(); }
            row-menu-action(action, id) => { root.library-row-menu-action(action, id); }
            disassemble-cancelled => { root.library-disassemble-cancelled(); }
            disassemble-confirmed(id) => { root.library-disassemble-confirmed(id); }
            delete-cancelled => { root.library-delete-cancelled(); }
            delete-confirmed(id) => { root.library-delete-confirmed(id); }
            bundle-opened(id) => { root.library-bundle-clicked(id); }
            discard-cancelled => { root.library-discard-cancelled(); }
            discard-confirmed(id) => { root.library-discard-confirmed(id); }
            delete-both-requested(id) => { root.library-delete-both-requested(id); }
            delete-both-cancelled => { root.library-delete-both-cancelled(); }
            delete-both-confirmed(id) => { root.library-delete-both-confirmed(id); }
            reclaim-space-clicked => { root.reclaim-space-clicked(); }
        }

        // REVIEW & UPDATE (`ticket 13` locked mode, `ticket 14` editing) - declared AFTER the Library
        // so it stacks above it, never in place of it. `library-open` stays true underneath the whole
        // time this is open.
        if root.review-update-open : SdReviewUpdate {
            blocks: root.review-update-blocks;
            provenance: root.review-update-provenance;
            editing: root.review-update-editing;
            cancel-pending <=> root.review-update-cancel-pending;

            closed => { root.review-update-closed(); }
            edit-clicked => { root.review-update-edit-clicked(); }
            field-edited(kind, finding-ordinal, marker-ordinal, text) => {
                root.review-update-field-edited(kind, finding-ordinal, marker-ordinal, text);
            }
            save-clicked => { root.review-update-save-clicked(); }
            cancel-clicked => { root.review-update-cancel-clicked(); }
            discard-clicked => { root.review-update-discard-clicked(); }
        }

        // SETTINGS - above the Editor, below the context menu and the confirmations, because those
        // two can be raised from inside it.
        if root.settings-open : SdSettings {
            tab <=> root.settings-tab;
            run-at-startup: root.run-at-startup;
            startup-problem: root.startup-problem;
            open-editor-after-capture: root.open-editor-after-capture;
            vault-path: root.vault-path;
            budget-name: root.budget-name;
            budget-max-long-edge: root.budget-max-long-edge;
            budget-encoder-quality: root.budget-encoder-quality;
            budget-resize-percent: root.budget-resize-percent;
            budget-readout: root.budget-readout;
            budget-explainer: root.budget-explainer;
            hotkeys: root.hotkeys;
            app-version: root.app-version;
            bridge-status: root.bridge-status;
            listening <=> root.hotkey-listening;
            last-fired: root.hotkey-last-fired;
            last-fired-text: root.hotkey-last-fired-text;
            hotkey-feedback <=> root.hotkey-feedback;
            hotkey-feedback-is-error <=> root.hotkey-feedback-is-error;
            hotkey-meta-key-label: root.hotkey-meta-key-label;
            chord-preview <=> root.hotkey-chord-preview;

            closed => { root.settings-closed(); }
            startup-toggled(on) => { root.startup-toggled(on); }
            open-editor-after-capture-toggled(on) => { root.open-editor-after-capture-toggled(on); }
            vault-browse => { root.vault-browse-clicked(); }
            vault-reveal => { root.vault-reveal-clicked(); }
            budget-chosen(name) => { root.budget-chosen(name); }
            budget-advanced(edge, quality, percent) => {
                root.budget-advanced(edge, quality, percent);
            }
            hotkey-pressed(action, ctrl, alt, shift, win, text) => {
                root.hotkey-key-pressed(action, ctrl, alt, shift, win, text);
            }
            hotkey-enabled-toggled(action, on) => { root.hotkey-enabled-toggled(action, on); }
            reclaim-space-clicked => { root.reclaim-space-clicked(); }
        }

        // RECLAIM SPACE (`ticket 18`) - declared AFTER both the Library and Settings so it stacks
        // ABOVE whichever one is open underneath (Slint draws later siblings on top), the same
        // reasoning `SdReviewUpdate`'s own mount comment gives. Neither `library-open` nor
        // `settings-open` is touched by this block - closing Reclaim space simply reveals whichever
        // one was already there.
        if root.reclaim-space-open : SdReclaimSpace {
            rows: root.reclaim-space-rows;
            total-label: root.reclaim-space-total-label;
            footer-label: root.reclaim-space-footer-label;
            selected-count: root.reclaim-space-selected-count;
            confirm-open: root.reclaim-space-confirm-open;
            confirm-heading: root.reclaim-space-confirm-heading;
            confirm-body: root.reclaim-space-confirm-body;

            closed => { root.reclaim-space-closed(); }
            row-toggled(id) => { root.reclaim-space-row-toggled(id); }
            discard-clicked => { root.reclaim-space-discard-clicked(); }
            discard-cancelled => { root.reclaim-space-discard-cancelled(); }
            discard-confirmed => { root.reclaim-space-discard-confirmed(); }
        }

        // MOVING THE VAULT - confirmed, because it moves every file the product owns.
        //
        // The owner asked for it in as many words, and for the reason: *"Artinya jangan sampai malah
        // gak bisa jalan lagi setelah new vault."* A folder picker that started moving files the
        // moment it closed would give no moment to change your mind about a hundred captures.
        if root.pending-vault-folder != "" : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay-scrim;
            TouchArea {
                clicked => { root.pending-vault-folder = ""; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 440px;
                height: vault-body.preferred-height;
                background: root.bg-card;
                border-width: 1px;
                border-color: root.border-strong;
                border-radius: Theme.radius-sharp;
                drop-shadow-blur: 32px;
                drop-shadow-color: Theme.overlay-shadow;
                TouchArea { }

                vault-body := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    SdSectionLabel { text: "MOVE THE VAULT?"; }

                    Text {
                        text: root.pending-vault-file-count == 0
                            ? "The Vault is empty, so nothing has to move. Snapdown will store new captures here from the next start."
                            : "All " + root.pending-vault-file-count + " file(s) in the current Vault will be moved into this folder. Your Findings keep working — they refer to their images by a path relative to the Vault, so nothing in the Library has to change.";
                        font-size: 12px;
                        color: root.text-secondary;
                        wrap: word-wrap;
                        font-family: "IBM Plex Sans";
                    }

                    SdTextField {
                        read-only: true;
                        mono: true;
                        text-size: 11px;
                        pad: 8px;
                        text: root.pending-vault-folder;
                    }

                    Text {
                        text: "If the move fails part-way, nothing is lost: the old folder stays in use until every file has arrived. Snapdown will restart itself once the move is done.";
                        font-size: 10px;
                        color: root.text-dim;
                        wrap: word-wrap;
                        font-family: "IBM Plex Sans";
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        SdActionButton {
                            label: "Keep the current folder";
                            primary: false;
                            height: 30px;
                            clicked => { root.pending-vault-folder = ""; }
                        }
                        SdActionButton {
                            label: "Move it";
                            height: 30px;
                            clicked => {
                                root.vault-migration-confirmed(root.pending-vault-folder);
                                root.pending-vault-folder = "";
                            }
                        }
                    }
                }
            }
        }

        // DELETING A FINDING - confirmed once, never twice, and never not at all.
        //
        // `UC-7` and the Product Brief both put the safety here rather than in a recycle bin: the row
        // and the file go together and nothing keeps a copy. Declared before the context menu so the
        // menu can raise it and be gone.
        if root.pending-delete-finding != "" : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay-scrim;
            TouchArea {
                clicked => { root.pending-delete-finding = ""; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 380px;
                height: confirm-body.preferred-height;
                background: root.bg-card;
                border-width: 1px;
                border-color: root.border-strong;
                border-radius: Theme.radius-sharp;
                drop-shadow-blur: 32px;
                drop-shadow-color: Theme.overlay-shadow;
                TouchArea { }

                confirm-body := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    SdSectionLabel {
                        text: root.pending-delete-count > 1
                            ? "DELETE " + root.pending-delete-count + " FINDINGS?"
                            : "DELETE THIS FINDING?";
                    }

                    Text {
                        text: root.pending-delete-count > 1
                            ? "All " + root.pending-delete-count + " selected captures go, with their Notes, Markers, annotations and image files. This cannot be undone."
                            : "The capture, its Note, its Markers and its annotations go, and so does the image file. This cannot be undone.";
                        font-size: 12px;
                        color: root.text-secondary;
                        wrap: word-wrap;
                        font-family: "IBM Plex Sans";
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        SdActionButton {
                            label: "Keep it";
                            primary: false;
                            height: 30px;
                            clicked => { root.pending-delete-finding = ""; }
                        }
                        SdActionButton {
                            label: root.pending-delete-count > 1
                                ? "Delete " + root.pending-delete-count : "Delete";
                            height: 30px;
                            clicked => {
                                root.delete-finding-confirmed(root.pending-delete-finding);
                                root.pending-delete-finding = "";
                            }
                        }
                    }
                }
            }
        }

        // THE CONTEXT MENU - above the Editor, below the Assemble modal.
        //
        // Declared here rather than beside the thing it belongs to, because a menu drawn inside the
        // canvas would be clipped by it: a right-click near the bottom of the image would open a
        // menu with its lower half cut off.
        if root.menu-subject != "" : SdContextMenu {
            entries: root.menu-subject == "annotation"
                ? root.annotation-menu
                : (root.menu-subject == "finding"
                    ? root.finding-menu
                    : (root.menu-subject == "marker" ? root.marker-menu : root.canvas-menu));
            at-x: root.menu-x;
            at-y: root.menu-y;
            dismissed => { root.menu-subject = ""; }
            chosen(action) => {
                // Read before the menu closes: closing clears the target.
                if (action == "delete") {
                    root.annotation-deleted(root.menu-target);
                }
                if (action == "front" || action == "forward"
                    || action == "backward" || action == "back") {
                    root.annotation-reordered(root.menu-target, action);
                }
                if (action == "delete-marker") {
                    root.delete-marker-clicked(root.menu-target);
                }
                if (action == "assemble") {
                    root.assemble-bundle-clicked();
                }
                if (action == "copy") {
                    root.copy-image-clicked();
                }
                if (action == "reveal") {
                    root.open-file-location-clicked(
                        root.menu-subject == "finding" ? root.menu-target : root.active-finding-id);
                }
                if (action == "undo") { root.annotation-undo(); }
                if (action == "redo") { root.annotation-redo(); }
                // Deleting a capture is the one action here that cannot be taken back, so it asks
                // first rather than firing from the menu.
                if (action == "delete-finding") {
                    root.pending-delete-count = root.menu-target-selected
                        ? root.selected-finding-count : 1;
                    root.pending-delete-finding = root.menu-target;
                }
                root.menu-subject = "";
            }
        }

        // ASSEMBLE & REVIEW - the last thing declared, so it is above everything including the
        // result line.
        //
        // A RENDERED document, not the raw CommonMark. The first version showed the Markdown source
        // in a monospace pane beside a list of contents with a remove button on each row; the owner's
        // reading of it was that this screen is a final look at what the agent will get, so it should
        // look like what the agent will get - headings as headings, and the image actually visible.
        // The contents list and the per-item removal went with that: choosing what goes in is the
        // filmstrip's job, and doing it in two places is two places to disagree.
        //
        // The UX asset's third column - Copy Markdown, Local MCP Bridge, Publish - is still absent.
        // None of the three exists: no clipboard dependency, `BUG-59` for the Bridge's endpoints,
        // `DEC-005` for publishing. Drawing them would be `BUG-57` again.
        if root.bundle-preview-open : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay-scrim;

            // Swallows every click that misses the panel, so the Editor behind is inert.
            TouchArea { }

            // Escape closes it. Declared before the panel and focused on creation, so it holds the
            // keyboard until the Reviewer clicks into a field.
            preview-keys := FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.bundle-preview-cancelled();
                        return accept;
                    }
                    return reject;
                }
            }

            // A PAGE, not a dialog: it grows with the window and keeps A4's 1:1.414 portrait ratio,
            // because what it holds is a document and a document has a comfortable measure. At
            // 880x640 it was landscape and far wider than any line of prose wants to be - the
            // owner's words were "kenapa saya merasa kelebaran".
            //
            // Height drives width, one direction only, so there is no circular layout.
            preview-panel := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                height: max(420px, parent.height - 64px);
                width: min(parent.width - 64px, max(520px, self.height / 1.414));
                background: root.bg-app;
                border-radius: Theme.radius-sharp;
                border-width: 1px;
                border-color: root.border-strong;
                drop-shadow-blur: 32px;
                drop-shadow-color: Theme.overlay-shadow;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // HEADER - the shared one.
                    //
                    // This was 52px of hand-written header, and the Settings screen then grew a
                    // second one that differed in every detail the owner listed: a "Done" button
                    // where the ✕ is, a 700-weight title instead of 800, no icon. Two places showing
                    // the same kind of thing, agreeing by numbers rather than by component - which
                    // `design-system-guide.md` says drifts the first time one is touched, and it did.
                    //
                    // `SdModalHeader` owns the 52px, the accent icon, the 13px/800 title and the
                    // drawn ✕. What is passed as a child is what two modals legitimately differ by:
                    // here, the cost readout and the Edit/Preview pair.
                    SdModalHeader {
                        icon: @image-url("../assets/icons/package.svg");
                        title: "Assemble & Review";
                        closed => { root.bundle-preview-cancelled(); }

                        Text {
                            text: root.bundle-preview-finding-count + " Finding" + (root.bundle-preview-finding-count == 1 ? "" : "s") + "  ·  ~" + root.bundle-preview-text-tokens + " tk";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.accent-primary;
                            vertical-alignment: center;
                            font-family: "IBM Plex Mono";
                        }

                        // EDIT / PREVIEW. Edit is the default because every piece of content is
                        // written in the rendered view; Preview is the CommonMark, read-only, so the
                        // Reviewer can see what will actually be handed over.
                        //
                        // `SdSegmented` now - the same control the Quality Budget presets use, and
                        // the one this treatment was copied out of by hand three times.
                        Rectangle {
                            width: 132px;
                            VerticalLayout {
                                alignment: center;
                                SdSegmented {
                                    selected: root.bundle-preview-shows-source ? "source" : "edit";
                                    options: [
                                        { id: "edit", label: "Edit" },
                                        { id: "source", label: "Preview" },
                                    ];
                                    chosen(id) => {
                                        root.bundle-preview-shows-source = id == "source";
                                    }
                                }
                            }
                        }
                    }

                    // THE DOCUMENT, in two views, and the only place any of it is edited.
                    //
                    // PREVIEW renders it - headings at their Markdown level, the image visible - and
                    // every piece of CONTENT is editable in place: the title, the Bundle note, a
                    // Finding's note, each Marker's note. What is NOT editable there is what the
                    // product generates: a Finding's heading and its image reference.
                    //
                    // CODE is the whole CommonMark, as text, editable without restriction. The
                    // owner's framing: "user harus dengan sadar menulis bagaimana markdown akhirnya".
                    // Breaking the template is allowed - it is a document, and it is theirs.
                    //
                    // Deleting the image reference does NOT cancel the image. The burned copies are
                    // written from the plan, not from the Markdown, so a Bundle whose document does
                    // not mention its images still carries them.
                    //
                    // Once Code has been typed in, the hand-written text is what gets written and
                    // Preview says so rather than quietly regenerating over it.
                    Rectangle {
                        vertical-stretch: 1;
                        background: root.bg-app;

                        preview-scroll := ScrollView {
                            width: 100%;
                            height: 100%;
                            vertical-scrollbar-policy: always-off;
                            horizontal-scrollbar-policy: always-off;
                            viewport-width: self.visible-width;

                            VerticalLayout {
                                padding-left: 22px;
                                padding-right: 30px;
                                padding-top: 16px;
                                padding-bottom: 22px;
                                spacing: 10px;
                                alignment: start;

                                // --- PREVIEW: exactly what the agent will be handed -------------
                                //
                                // Read-only on purpose. The document is edited in the rendered view;
                                // this one exists so the Reviewer can see the file before it is
                                // written, and a second place to type would be a second source of
                                // truth for the same document.
                                if root.bundle-preview-shows-source : SdTextField {
                                    flat: true;
                                    read-only: true;
                                    pad: 2px;
                                    text-size: 12px;
                                    mono: true;
                                    placeholder: "The composed CommonMark appears here.";
                                    text: root.bundle-preview-markdown;
                                }

                                // --- PREVIEW ----------------------------------------------------
                                // --- EDIT: the document, rendered, and every piece of content editable in place ---
                                if !root.bundle-preview-shows-source : VerticalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    for block in root.bundle-preview-blocks : VerticalLayout {
                                        spacing: 4px;
                                        alignment: start;

                                        // `# ` - the Bundle's title
                                        if block.kind == "title" : SdTextField {
                                            flat: true;
                                            pad: 2px;
                                            text-size: 19px;
                                            placeholder: "Name this handoff";
                                            text: block.text;
                                            edited => { root.bundle-block-edited(block.kind, "", "", self.text); }
                                        }

                                        // `## Bundle Notes`
                                        if block.kind == "bundle-notes" : SdDocHeading {
                                            level: 2;
                                            text: "Bundle Notes";
                                        }
                                        if block.kind == "bundle-notes" : SdTextField {
                                            flat: true;
                                            pad: 2px;
                                            text-size: 12px;
                                            placeholder: "What is this handoff about? The agent reads this first.";
                                            text: block.text;
                                            edited => { root.bundle-block-edited(block.kind, "", "", self.text); }
                                        }

                                        // `## Finding N` - generated, so not editable
                                        if block.kind == "finding" : SdDocHeading {
                                            level: 2;
                                            text: "Finding " + block.ordinal;
                                        }

                                        // The image the agent will fetch: the burned copy.
                                        if block.kind == "image" : HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                // HALF the page at most, at the owner's direction:
                                                // the notes are what this screen is for, and a
                                                // full-measure screenshot buries them.
                                                //
                                                // Bounded by the PANEL's width, not by
                                                // `parent.width`. Reading the parent here is a
                                                // binding loop - the layout's width comes from its
                                                // content, and this is that content. The panel's
                                                // width comes from its own height, so it is outside
                                                // the loop.
                                                width: min((preview-panel.width - 52px) * 0.5, block.image.width * 1px);
                                                height: block.image.width > 0
                                                    ? self.width * (block.image.height / block.image.width)
                                                    : 0px;
                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    image-fit: contain;
                                                    source: block.image;
                                                }
                                            }
                                        }

                                        // `### Notes`, and only when there is one. An empty note is
                                        // left out of the document, so it is left out of here too.
                                        if block.kind == "note" : SdDocHeading {
                                            level: 3;
                                            text: "Notes";
                                        }
                                        if block.kind == "note" : SdTextField {
                                            flat: true;
                                            pad: 2px;
                                            text-size: 12px;
                                            text: block.text;
                                            edited => { root.bundle-block-edited(block.kind, block.finding-id, "", self.text); }
                                        }

                                        // `### Marker Notes`, printed once above the list.
                                        if block.kind == "marker" && block.starts-section : SdDocHeading {
                                            level: 3;
                                            text: "Marker Notes";
                                        }
                                        if block.kind == "marker" : HorizontalLayout {
                                            spacing: 6px;
                                            // NO `alignment: start`. It gives every child its
                                            // minimum width and distributes nothing, so the note
                                            // field - stretchy or not - got none of the row and
                                            // wrapped one character per line. The default stretch is
                                            // what lets the ordinal keep its width and the note take
                                            // the rest.
                                            Text {
                                                text: block.ordinal + ".";
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: root.text-muted;
                                                vertical-alignment: top;
                                                font-family: "IBM Plex Sans";
                                            }
                                            SdTextField {
                                                flat: true;
                                                    horizontal-stretch: 1;
                                                pad: 2px;
                                                text-size: 12px;
                                                placeholder: "(no note)";
                                                text: block.text;
                                                edited => { root.bundle-block-edited(block.kind, block.finding-id, block.marker-id, self.text); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if preview-scroll.viewport-height > preview-scroll.visible-height : SdScrollBar {
                            vertical: true;
                            viewport-extent: preview-scroll.viewport-height;
                            visible-extent: preview-scroll.visible-height;
                            offset: -preview-scroll.viewport-y;
                            scrolled(position) => { preview-scroll.viewport-y = -position; }
                            x: parent.width - self.width - 8px;
                            y: 4px;
                            height: parent.height - 8px;
                        }
                    }

                    // FOOTER
                    Rectangle {
                        height: 60px;
                        background: root.bg-card;
                        Rectangle { y: 0px; width: 100%; height: 1px; background: root.border-subtle; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;
                            alignment: end;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 86px;
                                height: 32px;
                                border-radius: Theme.radius-sharp;
                                border-width: 1px;
                                border-color: root.border-strong;
                                cancel-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.bundle-preview-cancelled(); }
                                }
                                background: cancel-touch.has-hover ? root.bg-hover : transparent;
                                Text {
                                    text: "Cancel";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-family: "IBM Plex Sans";
                                }
                            }

                            SdActionButton {
                                y: (parent.height - self.height) / 2;
                                label: "Assemble & Save";
                                icon: @image-url("../assets/icons/package.svg");
                                enabled: root.bundle-preview-finding-count > 0;
                                clicked => { root.bundle-preview-confirmed(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
